---
/**
 * Astro props for the full-screen ASCII Mandelbrot zoom.
 * @typedef {Object} AnimateProps
 * @property {string} text Optional sine-scroller message; empty by default.
 * @property {number} opacity Overall effect opacity from 0 to 1 (default 0.35).
 * @property {number} speed Animation speed multiplier (default 1).
 * @property {string[]} colors Up to eight hex colors. Slots 0-6 form the band gradient
 *   (dark -> bright); slot 7 is the accent used for the scroller and sparkles.
 * @property {number} fontSize Monospace character size in pixels (default 14).
 */
const {
	text = '',
	opacity = 0.35,
	speed = 1,
	colors,
	fontSize = 14,
} = Astro.props;

// Site palette: deep purple, violet, magenta, soft pink, lavender, cyan, blue, lime accent.
const fallbackColors = ['#59406f', '#8e5bd0', '#ff4fd8', '#ff9be9', '#e9dff4', '#40f4ff', '#3a8fd0', '#b9ff66'];
const palette = fallbackColors.map((fallback, index) => {
	const candidate = Array.isArray(colors) ? colors[index] : '';
	return typeof candidate === 'string' && /^#(?:[\da-f]{3}|[\da-f]{6})$/i.test(candidate) ? candidate : fallback;
});
const safeOpacity = Number.isFinite(opacity) ? Math.min(1, Math.max(0, opacity)) : 0.35;
const safeFontSize = Number.isFinite(fontSize) ? Math.min(28, Math.max(8, fontSize)) : 14;
const safeSpeed = Number.isFinite(speed) ? Math.max(0, Math.min(4, speed)) : 1;
const paletteStyle = `${palette.map((color, index) => `--c${index}:${color}`).join(';')};--effect-opacity:${safeOpacity};--cell-font-size:${safeFontSize}px`;
---

<div class="animate-stage">
	<pre
		class="animate-output"
		data-animate-output
		data-text={text}
		data-opacity={safeOpacity}
		data-speed={safeSpeed}
		data-colors={JSON.stringify(palette)}
		data-font-size={safeFontSize}
		style={paletteStyle}
		aria-hidden="true"
	></pre>
</div>

<script>
	// ---------------------------------------------------------------------------
	// Endless Mandelbrot zoom, rendered as ASCII.
	//
	// The zoom aims at c* = -1.78644025556..., the fixed point of "tuning" by the
	// period-3 airplane minibrot. Every minibrot there contains a smaller copy of
	// the whole Mandelbrot set at the same spot, so zooming by a factor of
	// 55.247 lands on a picture that is the same as the one we started from:
	//   * the view scale shrinks by 55.247 per cycle, with no rotation;
	//   * escape counts triple (mu' = 3 mu + 4.95), so log3(mu + 2.475) gains
	//     exactly 1 per cycle and the colour bands line up again.
	// We therefore only ever zoom through ONE cycle and then wrap back. The
	// zoom is endless, never runs out of floating point precision, and each
	// cycle passes through a complete copy of the Mandelbrot set.
	// ---------------------------------------------------------------------------
	const density = ' .:-=+*#%@';
	// Palette slots walked by successive colour bands: deep purple -> violet -> magenta -> pink -> lavender -> cyan -> blue -> violet.
	const ramp = [0, 1, 2, 3, 4, 5, 6, 1];
	// Scroller letters cycle through pink, cyan, soft pink and the lime accent.
	const accents = [2, 5, 3, 7];
	const active = new Map();

	const MAX_ITERATIONS = 3000;
	const BAILOUT = 1e5;
	const FIXED_RE = -1.786440255563644;
	const FIXED_IM = 0;
	const ZOOM_PER_CYCLE = 55.247;
	const CYCLE_LOG = Math.log(ZOOM_PER_CYCLE);
	const LOG3 = Math.log(3);
	const COUNT_OFFSET = 2.475;
	const BANDS_PER_CYCLE = 8; // must equal ramp.length so the colours repeat exactly each cycle
	const CYCLE_RATE = 1 / 8; // cycles per second at speed 1 (about 1.6x magnification per second)
	const LOOP_SCALE = 0.003; // view half-size where the endless cycle starts
	const START_SCALE = 2; // opening view: the whole Mandelbrot set
	const START_RE = -0.5;
	const START_IM = 0;
	// c* sits at the left tip (the antenna) of every Mandelbrot copy. Any constant screen offset keeps the loop seamless, so c* is
	// parked left of centre and each complete copy passes through the middle of the screen.
	const TARGET_X = -0.39;
	const TARGET_Y = 0;
	// While diving in, c* starts at (PSI_RE, PSI_IM) in view units (so the opening view is the whole set) and glides to the target.
	const PSI_RE = (FIXED_RE - START_RE) / START_SCALE;
	const PSI_IM = (FIXED_IM - START_IM) / START_SCALE;
	const INTRO_CYCLES = Math.log(START_SCALE / LOOP_SCALE) / CYCLE_LOG;

	const bitmapFont = {
		A: ['01110', '10001', '10001', '11111', '10001', '10001', '10001'],
		B: ['11110', '10001', '10001', '11110', '10001', '10001', '11110'],
		C: ['01111', '10000', '10000', '10000', '10000', '10000', '01111'],
		D: ['11110', '10001', '10001', '10001', '10001', '10001', '11110'],
		E: ['11111', '10000', '10000', '11110', '10000', '10000', '11111'],
		F: ['11111', '10000', '10000', '11110', '10000', '10000', '10000'],
		G: ['01111', '10000', '10000', '10111', '10001', '10001', '01111'],
		H: ['10001', '10001', '10001', '11111', '10001', '10001', '10001'],
		I: ['11111', '00100', '00100', '00100', '00100', '00100', '11111'],
		J: ['00111', '00010', '00010', '00010', '00010', '10010', '01100'],
		K: ['10001', '10010', '10100', '11000', '10100', '10010', '10001'],
		L: ['10000', '10000', '10000', '10000', '10000', '10000', '11111'],
		M: ['10001', '11011', '10101', '10101', '10001', '10001', '10001'],
		N: ['10001', '11001', '10101', '10011', '10001', '10001', '10001'],
		O: ['01110', '10001', '10001', '10001', '10001', '10001', '01110'],
		P: ['11110', '10001', '10001', '11110', '10000', '10000', '10000'],
		Q: ['01110', '10001', '10001', '10001', '10101', '10010', '01101'],
		R: ['11110', '10001', '10001', '11110', '10100', '10010', '10001'],
		S: ['01111', '10000', '10000', '01110', '00001', '00001', '11110'],
		T: ['11111', '00100', '00100', '00100', '00100', '00100', '00100'],
		U: ['10001', '10001', '10001', '10001', '10001', '10001', '01110'],
		V: ['10001', '10001', '10001', '10001', '10001', '01010', '00100'],
		W: ['10001', '10001', '10001', '10101', '10101', '10101', '01010'],
		X: ['10001', '10001', '01010', '00100', '01010', '10001', '10001'],
		Y: ['10001', '10001', '01010', '00100', '00100', '00100', '00100'],
		Z: ['11111', '00001', '00010', '00100', '01000', '10000', '11111'],
		0: ['01110', '10001', '10011', '10101', '11001', '10001', '01110'],
		1: ['00100', '01100', '00100', '00100', '00100', '00100', '01110'],
		2: ['01110', '10001', '00001', '00010', '00100', '01000', '11111'],
		3: ['11110', '00001', '00001', '01110', '00001', '00001', '11110'],
		4: ['00010', '00110', '01010', '10010', '11111', '00010', '00010'],
		5: ['11111', '10000', '10000', '11110', '00001', '00001', '11110'],
		6: ['01110', '10000', '10000', '11110', '10001', '10001', '01110'],
		7: ['11111', '00001', '00010', '00100', '01000', '01000', '01000'],
		8: ['01110', '10001', '10001', '01110', '10001', '10001', '01110'],
		9: ['01110', '10001', '10001', '01111', '00001', '00001', '01110'],
		'*': ['00000', '10101', '01110', '11111', '01110', '10101', '00000'],
		'-': ['00000', '00000', '00000', '11111', '00000', '00000', '00000'],
		'.': ['00000', '00000', '00000', '00000', '00000', '01100', '01100'],
		'!': ['00100', '00100', '00100', '00100', '00100', '00000', '00100'],
	};

	function smoothstep(start, end, value) {
		const amount = Math.max(0, Math.min(1, (value - start) / (end - start)));
		return amount * amount * (3 - 2 * amount);
	}

	// Smooth escape count, or -1 for points inside the set (or never escaping within the iteration budget).
	function escapeTime(cr, ci) {
		const y2 = ci * ci;
		let x = cr - 0.25;
		const q = x * x + y2;
		if (q * (q + x) <= 0.25 * y2) return -1; // main cardioid
		x = cr + 1;
		if (x * x + y2 <= 0.0625) return -1; // period-2 bulb
		let zr = 0;
		let zi = 0;
		let zr2 = 0;
		let zi2 = 0;
		let savedR = 0;
		let savedI = 0;
		for (let n = 0; n < MAX_ITERATIONS; n += 1) {
			zi = 2 * zr * zi + ci;
			zr = zr2 - zi2 + cr;
			zr2 = zr * zr;
			zi2 = zi * zi;
			const magnitude = zr2 + zi2;
			if (magnitude > BAILOUT) {
				// n + 1 - log2(ln|z|) removes the integer banding from the escape count.
				return n + 1 - Math.log(Math.log(magnitude) * 0.5) / Math.LN2;
			}
			// Brent-style cycle detection: points that settle into an attracting cycle are inside, so stop early.
			if ((n & (n - 1)) === 0) {
				savedR = zr;
				savedI = zi;
			} else if (Math.abs(zr - savedR) < 1e-13 && Math.abs(zi - savedI) < 1e-13) {
				return -1;
			}
		}
		return -1;
	}

	function initialize(output) {
		if (active.has(output)) return;

		const fontSize = Number(output.dataset.fontSize) || 14;
		const speed = Number(output.dataset.speed) || 0;
		const message = (output.dataset.text || '').toUpperCase();

		const probe = document.createElement('span');
		probe.textContent = 'M';
		probe.style.fontSize = `${fontSize}px`;
		probe.style.fontFamily = '"Courier New", Courier, monospace';
		probe.style.fontWeight = '700';
		probe.style.lineHeight = '1';
		probe.style.whiteSpace = 'pre';
		probe.style.display = 'inline-block';
		probe.style.position = 'fixed';
		probe.style.left = '-10000px';
		probe.style.top = '-10000px';
		probe.style.visibility = 'hidden';
		document.body.appendChild(probe);
		const probeBounds = probe.getBoundingClientRect();
		const cellWidth = Math.max(1, probeBounds.width);
		const cellHeight = Math.max(1, probeBounds.height);
		probe.remove();

		let columns = 1;
		let rows = 1;
		let shades = new Uint8Array(1); // index into the density ramp for every cell
		let colors = new Uint8Array(1); // palette slot for every cell
		let bandValue = new Float32Array(1); // log3 of the escape count per cell, -1 inside the set
		let gridX = new Float32Array(1); // per-cell offset from the view centre, in view units
		let gridY = new Float32Array(1);
		let vignette = new Float32Array(1);
		let frame = 0;
		let resizeTimer = 0;
		let elapsed = 0;
		let lastFrame = 0;
		let running = false;
		let onscreen = false;
		let stride = 1; // adaptive: compute every Nth column on slow machines
		let renderCost = 8;
		// phase < 0: the opening dive from the full set; phase in [0, 1): the endless self-similar cycle.
		let phase = -INTRO_CYCLES;
		const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

		function resize() {
			const bounds = output.getBoundingClientRect();
			columns = Math.max(1, Math.floor(bounds.width / cellWidth));
			rows = Math.max(1, Math.floor(bounds.height / cellHeight));
			const count = columns * rows;
			shades = new Uint8Array(count);
			colors = new Uint8Array(count);
			bandValue = new Float32Array(count);
			gridX = new Float32Array(count);
			gridY = new Float32Array(count);
			vignette = new Float32Array(count);
			// Work in pixels so the fractal is isotropic even though character cells are about twice as tall as wide.
			const gridWidth = columns * cellWidth;
			const gridHeight = rows * cellHeight;
			const half = Math.max(gridWidth, gridHeight) / 2;
			for (let row = 0; row < rows; row += 1) {
				const y = ((row + 0.5) * cellHeight - gridHeight / 2) / half;
				for (let column = 0; column < columns; column += 1) {
					const x = ((column + 0.5) * cellWidth - gridWidth / 2) / half;
					const index = row * columns + column;
					gridX[index] = x;
					gridY[index] = y;
					vignette[index] = Math.max(0.4, 1 - 0.4 * (x * x + y * y));
				}
			}
		}

		function put(column, row, shade, colorIndex) {
			if (column < 0 || row < 0 || column >= columns || row >= rows) return;
			const index = row * columns + column;
			shades[index] = shade;
			colors[index] = colorIndex;
		}

		function drawFractal(time) {
			// Zoom in by ZOOM_PER_CYCLE each cycle. Negative phase is the opening dive from the whole set.
			const scale = LOOP_SCALE * Math.exp(-CYCLE_LOG * phase);
			const intro = phase < 0 ? Math.min(1, -phase / INTRO_CYCLES) : 0;
			const pull = intro * intro;
			const baseRe = FIXED_RE - scale * (TARGET_X + (PSI_RE - TARGET_X) * pull);
			const baseIm = FIXED_IM - scale * (TARGET_Y + (PSI_IM - TARGET_Y) * pull);
			const fade = smoothstep(0, 2.2, time);
			const reveal = smoothstep(0, 1.4, time);
			const revealRow = reveal * rows;
			const shimmer = Math.floor(time * 4) % 3;

			// Pass 1: log3 of the smooth escape count for every cell (every Nth column when the machine is struggling).
			for (let row = 0; row < rows; row += 1) {
				const rowStart = row * columns;
				for (let column = 0; column < columns; column += stride) {
					const index = rowStart + column;
					const mu = escapeTime(baseRe + scale * gridX[index], baseIm + scale * gridY[index]);
					// Escape counts triple per cycle, so this value gains exactly 1 per cycle: the colours loop seamlessly.
					const value = mu < 0 ? -1 : Math.log(mu + COUNT_OFFSET) / LOG3;
					bandValue[index] = value;
					for (let copy = 1; copy < stride && column + copy < columns; copy += 1) bandValue[index + copy] = value;
				}
			}

			// Pass 2: turn the values into colour bands with a copper-bar style gradient.
			for (let row = 0; row < rows; row += 1) {
				if (row > revealRow) break; // top-to-bottom raster reveal on load
				const rowStart = row * columns;
				for (let column = 0; column < columns; column += 1) {
					const index = rowStart + column;
					const value = bandValue[index];
					if (value < 0) {
						shades[index] = 0; // inside the set stays dark
						continue;
					}
					// How many colour bands fit between this cell and its neighbours? Beyond ~1 they cannot be resolved in
					// ASCII (it would just be noise), so those cells melt into a calm pink/cyan shimmer instead.
					const right = column < columns - 1 ? bandValue[index + 1] : columns > 1 ? bandValue[index - 1] : value;
					const below = row < rows - 1 ? bandValue[index + columns] : rows > 1 ? bandValue[index - columns] : value;
					const gradient = Math.max(right < 0 ? 99 : Math.abs(value - right), below < 0 ? 99 : Math.abs(value - below));
					const flat = smoothstep(0.9, 2.4, gradient * BANDS_PER_CYCLE);
					// Whole numbers pick a colour from the ramp, the fraction picks the gradient shade.
					const position = value * BANDS_PER_CYCLE;
					const band = Math.floor(position);
					const fraction = position - band;
					const triangle = 1 - Math.abs(fraction * 2 - 1);
					const banded = 1 - (1 - triangle) * (1 - triangle);
					const spark = (column + row * 2 + shimmer) % 3;
					const level = (banded + (0.5 + 0.12 * spark - banded) * flat) * vignette[index] * fade;
					shades[index] = Math.min(density.length - 1, Math.floor(level * (density.length - 1) + 0.5));
					colors[index] = flat > 0.5 ? (spark === 0 ? 2 : 5) : ramp[((band % 8) + 8) % 8];
				}
			}

			// Bright raster line riding the reveal front.
			if (reveal < 1) {
				const front = Math.floor(revealRow);
				for (let column = 0; column < columns; column += 1) {
					put(column, front, 9, (Math.floor(column / 6) + Math.floor(time * 12)) % 2 === 0 ? 2 : 5);
				}
			}
		}

		function drawScroller(time) {
			if (!message.length || time < 2.2) return;
			const pixelWidth = 3; // 3x2 cells per font pixel is close to square for a ~0.6 cell aspect
			const pixelHeight = 2;
			const advance = 6 * pixelWidth;
			const baseRow = Math.max(0, rows - 7 * pixelHeight - 4);
			const offset = time * speed * 20;
			const tick = Math.floor(time * 2.2);
			// Pass 0 lays a dark drop shadow so the text stays readable over the fractal; pass 1 draws the letters.
			for (let pass = 0; pass < 2; pass += 1) {
				for (let column = 0; column < columns; column += 1) {
					const sourceX = column + offset;
					const characterIndex = Math.floor(sourceX / advance) % message.length;
					const glyphColumn = Math.floor((sourceX % advance) / pixelWidth);
					if (glyphColumn > 4) continue;
					const glyph = bitmapFont[message[characterIndex]];
					if (!glyph) continue;
					const wave = Math.round(Math.sin(column * 0.09 + time * speed * 2.4) * 2);
					const colorIndex = accents[(characterIndex + tick) % accents.length];
					for (let glyphRow = 0; glyphRow < 7; glyphRow += 1) {
						if (glyph[glyphRow][glyphColumn] !== '1') continue;
						for (let part = 0; part < pixelHeight; part += 1) {
							const y = baseRow + glyphRow * pixelHeight + part + wave;
							if (pass === 0) put(column + 1, y + 1, 0, 0);
							else put(column, y, part === 0 ? 9 : 7, colorIndex);
						}
					}
				}
			}
		}

		function advance(delta) {
			elapsed += delta;
			// Faster during the opening dive, then a steady zoom forever.
			const intro = phase < 0 ? Math.min(1, -phase / INTRO_CYCLES) : 0;
			phase += delta * speed * CYCLE_RATE * (1 + 0.8 * intro);
			if (phase >= 1) phase -= Math.floor(phase); // the seamless wrap
		}

		function render() {
			shades.fill(0);
			drawFractal(elapsed);
			drawScroller(elapsed);

			let html = '';
			for (let row = 0; row < rows; row += 1) {
				const rowStart = row * columns;
				let runColor = -1;
				let run = '';
				for (let column = 0; column < columns; column += 1) {
					const index = rowStart + column;
					const shade = shades[index];
					if (shade === 0) {
						run += ' '; // blanks never break a colour run
						continue;
					}
					const color = colors[index];
					if (runColor === -1) runColor = color;
					if (color !== runColor) {
						html += `<span class="c${runColor}">${run}</span>`;
						run = '';
						runColor = color;
					}
					run += density[shade];
				}
				html += `<span class="c${runColor === -1 ? 0 : runColor}">${run}</span>\n`;
			}
			output.innerHTML = html;
		}

		// Keep frames affordable on huge screens or slow machines by sampling fewer columns.
		function adaptQuality(cost) {
			renderCost = renderCost * 0.85 + cost * 0.15;
			if (renderCost > 22 && stride < 3) {
				stride += 1;
				renderCost = 14;
			} else if (renderCost < 6 && stride > 1) {
				stride -= 1;
				renderCost = 14;
			}
		}

		function requestFrame() {
			if (running && !frame) frame = window.requestAnimationFrame(loop);
		}

		function loop(timestamp) {
			frame = 0;
			if (!running || document.hidden || !onscreen) return;
			if (timestamp - lastFrame >= 1000 / 30) {
				const delta = lastFrame ? Math.min(0.1, (timestamp - lastFrame) / 1000) : 0;
				lastFrame = timestamp;
				advance(delta);
				const started = performance.now();
				render();
				adaptQuality(performance.now() - started);
			}
			requestFrame();
		}

		function updateRunning() {
			const shouldRun = onscreen && !document.hidden && !motionPreference.matches;
			running = shouldRun;
			if (shouldRun) {
				lastFrame = performance.now();
				requestFrame();
			} else {
				window.cancelAnimationFrame(frame);
				frame = 0;
			}
		}

		function showStaticFrame() {
			elapsed = 4;
			phase = 0.35; // a complete copy of the Mandelbrot set fills the view here
			render();
		}

		function handleResize() {
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => {
				resize();
				render();
			}, 120);
		}

		function handleVisibility() {
			updateRunning();
		}

		function handleMotionChange() {
			if (motionPreference.matches) {
				window.cancelAnimationFrame(frame);
				frame = 0;
				running = false;
				showStaticFrame();
			} else {
				updateRunning();
			}
		}

		function cleanup() {
			running = false;
			window.cancelAnimationFrame(frame);
			window.clearTimeout(resizeTimer);
			window.removeEventListener('resize', handleResize);
			document.removeEventListener('visibilitychange', handleVisibility);
			motionPreference.removeEventListener('change', handleMotionChange);
			intersectionObserver.disconnect();
			resizeObserver.disconnect();
			active.delete(output);
		}

		const intersectionObserver = new IntersectionObserver((entries) => {
			onscreen = entries[0] ? entries[0].isIntersecting : false;
			updateRunning();
		});
		const resizeObserver = new ResizeObserver(handleResize);
		window.addEventListener('resize', handleResize, { passive: true });
		document.addEventListener('visibilitychange', handleVisibility);
		motionPreference.addEventListener('change', handleMotionChange);
		intersectionObserver.observe(output);
		resizeObserver.observe(output);
		active.set(output, cleanup);
		resize();
		if (motionPreference.matches) showStaticFrame();
		else render();
	}

	function initializeAll() {
		document.querySelectorAll('[data-animate-output]').forEach(initialize);
	}

	function cleanupAll() {
		active.forEach((cleanup) => cleanup());
		active.clear();
	}

	document.addEventListener('astro:page-load', initializeAll);
	document.addEventListener('astro:before-swap', cleanupAll);
	initializeAll();
</script>

<style>
	.animate-stage {
		position: relative;
		min-width: 0;
		min-height: 360px;
		overflow: hidden;
		background: #09070e;
	}

	.animate-output {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		overflow: hidden;
		pointer-events: auto;
		user-select: text;
		cursor: text;
		white-space: pre;
		font-family: "Courier New", Courier, monospace;
		font-size: var(--cell-font-size, 14px);
		line-height: 1;
		font-weight: 700;
		letter-spacing: 0;
		opacity: var(--effect-opacity, 0.35);
		background: transparent;
		color: var(--c0);
	}

	@media (max-width: 640px) {
		.animate-stage {
			min-height: 180px;
		}
	}

	.animate-probe {
		position: fixed;
		left: -10000px;
		top: -10000px;
		visibility: hidden;
		display: inline-block;
		white-space: pre;
		font-family: "Courier New", Courier, monospace;
		line-height: 1;
