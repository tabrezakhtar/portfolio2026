---
---

<section class="contact-section" id="contact" aria-labelledby="contact-title">
	<div class="terminal-window content-window">
		<div class="terminal-titlebar">
			<span class="terminal-title-mark" aria-hidden="true">❯</span>
			<span class="terminal-title">tabrez@localhost <span>~/contact</span> zsh</span>
			<span class="terminal-title-meta">hello.txt</span>
		</div>
		<div class="content-pane contact-pane">
			<p class="terminal-prompt"><span>tabrez@localhost</span>:~/contact$ echo $COLLAB</p>
			<p class="eyebrow"><span class="eyebrow-line"></span> Start a conversation</p>
			<div class="contact-heading">
				<h2 id="contact-title" data-decrypt>Let's Build Something Great Together</h2>
				<div>
					<p>Have an idea? I'd love to hear about it.</p>
					<p>Whether it's a small feature or an ambitious platform, I'm excited to help bring your vision to life.</p>
					<p>Drop me a message to get started.</p>
				</div>
			</div>
			<div class="contact-grid">
				<aside class="contact-location" aria-label="Location">
					<div class="location-copy">
						<i class="bx bx-map" aria-hidden="true"></i>
						<div>
							<h3>Based in London</h3>
							<p>Available for remote work across the UK.</p>
						</div>
					</div>
					<iframe
						data-src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d158926.86627494264!2d-0.1146137676107722!3d51.50895431897339!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2suk!4v1720817486884!5m2!1sen!2suk"
						title="Google Map showing London, UK"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
						class="contact-map"
					></iframe>
				</aside>
				<form class="contact-form" name="contact" method="POST" data-netlify="true" netlify netlify-honeypot="bot-field">
					<input type="hidden" name="form-name" value="contact" />
					<p class="form-honeypot" aria-hidden="true">
						<label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
					</p>
					<div class="form-row">
						<div class="form-field">
							<label for="contact-name">Name</label>
							<input id="contact-name" name="name" type="text" autocomplete="name" required />
						</div>
						<div class="form-field">
							<label for="contact-email">Email</label>
							<input id="contact-email" name="email" type="email" autocomplete="email" required />
						</div>
					</div>
					<div class="form-field">
						<label for="contact-message">Message</label>
						<textarea id="contact-message" name="message" rows="6" required></textarea>
					</div>
					<button class="contact-submit" type="submit">Send message <span aria-hidden="true">↗</span></button>
				</form>
			</div>
		</div>
		<div class="tmux-statusbar">
			<span class="tmux-status-session">[dev-session]</span>
			<span>0:portfolio-  1:projects-  2:about-  3:contact*</span>
			<span class="tmux-status-right">MAIL: OPEN</span>
		</div>
	</div>
</section>

<script>
	const contactMap = document.querySelector<HTMLIFrameElement>('.contact-map');
	if (contactMap?.dataset.src) {
		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver((entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					contactMap.src = contactMap.dataset.src ?? '';
					observer.disconnect();
				}
			}, { rootMargin: '200px' });
			observer.observe(contactMap);
		} else {
			contactMap.src = contactMap.dataset.src;
		}
	}
</script>

<style>
	.contact-heading h2 {
		font-family: 'Space Grotesk', sans-serif;
	}
</style>