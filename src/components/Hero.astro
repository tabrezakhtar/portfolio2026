---
import Animate from './Animate.astro';
import InteractiveTerminal from './InteractiveTerminal.astro';
---

<section class="hero" id="home" aria-labelledby="hero-title">
	<div class="terminal-window">
		<div class="terminal-titlebar">
			<span class="terminal-title-mark" aria-hidden="true">❯</span>
			<span class="terminal-title">tabrez@localhost <span>~</span> zsh</span>
			<span class="terminal-title-meta" data-terminal-dimensions>-- × --</span>
		</div>
		<div class="tmux-tabs" aria-label="Terminal windows">
			<span class="tmux-session">dev-session</span>
			<span class="tmux-tab tmux-tab--active">0: portfolio*</span>
			<a class="tmux-tab" href="#projects">1: projects</a>
			<a class="tmux-tab" href="#about">2: about</a>
			<span class="tmux-tabs-spacer"></span>
			<time class="tmux-clock" aria-label="Local time">UTF-8 · --:--:--</time>
		</div>
		<div class="terminal-grid">
			<div class="terminal-pane terminal-pane--intro">
				<div class="pane-title"><span>pane 0.0</span><span>~/home</span></div>
				<div class="pane-content">
					<div class="hero-copy">
						<p class="terminal-prompt"><span>tabrez@localhost</span>:~$ whoami</p>
						<p class="eyebrow"><span class="eyebrow-line"></span> Full-Stack Engineer · UI Tinkerer</p>
						<h1 id="hero-title" class="glitch-text" data-glitch-text="Developer. Problem solver. Builder.">Developer. Problem solver. <span>Builder.</span></h1>
						<p class="hero-description">
							I'm Tabrez, a Full-Stack Engineer with a passion for building software and exploring technology. I enjoy turning
							ideas into reality, creating interesting interfaces, solving problems and figuring out how things work.
							I'm always learning, experimenting and finding new things to build.
						</p>
						<a class="text-link" href="#projects">cd ~/projects <span aria-hidden="true">↘</span></a>
					</div>
					<Animate opacity={0.7} />
				</div>
			</div>
			<InteractiveTerminal />
		</div>
		<div class="tmux-statusbar">
			<span class="tmux-status-session">[dev-session]</span>
			<span>0:portfolio*  1:projects-  2:about-</span>
			<span class="tmux-status-right">tabrez · all systems nominal</span>
		</div>
	</div>
</section>

<script>
	const terminalDimensions = document.querySelector<HTMLElement>('[data-terminal-dimensions]');
	const terminalGrid = document.querySelector<HTMLElement>('.terminal-grid');
	if (terminalDimensions && terminalGrid) {
		const probe = document.createElement('span');
		probe.textContent = 'M';
		Object.assign(probe.style, {
			position: 'fixed',
			left: '-10000px',
			top: '-10000px',
			visibility: 'hidden',
			display: 'inline-block',
			font: getComputedStyle(terminalDimensions).font,
			lineHeight: 'normal',
		});
		document.body.appendChild(probe);
		const cell = probe.getBoundingClientRect();
		probe.remove();

		const updateTerminalDimensions = () => {
			const gridStyle = getComputedStyle(terminalGrid);
			const contentWidth = terminalGrid.clientWidth - parseFloat(gridStyle.paddingLeft) - parseFloat(gridStyle.paddingRight);
			const contentHeight = terminalGrid.clientHeight - parseFloat(gridStyle.paddingTop) - parseFloat(gridStyle.paddingBottom);
			const columns = Math.max(1, Math.floor(contentWidth / Math.max(1, cell.width)));
			const rows = Math.max(1, Math.floor(contentHeight / Math.max(1, cell.height)));
			terminalDimensions.textContent = `${columns} × ${rows}`;
			terminalDimensions.setAttribute('aria-label', `${columns} columns by ${rows} rows`);
		};

		updateTerminalDimensions();
		const dimensionsObserver = new ResizeObserver(updateTerminalDimensions);
		dimensionsObserver.observe(terminalGrid);
	}

	const clock = document.querySelector<HTMLTimeElement>('.tmux-clock');
	if (clock) {
		const updateClock = () => {
			const now = new Date();
			const time = new Intl.DateTimeFormat(undefined, {
				hour: '2-digit',
				minute: '2-digit',
				second: '2-digit',
				hourCycle: 'h23',
			}).format(now);
			clock.dateTime = now.toISOString();
			clock.textContent = `UTF-8 · ${time}`;
		};

		updateClock();
		window.setInterval(updateClock, 1000);
	}
</script>

<style>
	h1.glitch-text {
		font-family: 'Geist Pixel', monospace;
		font-weight: 400;
		line-height: 1.1;
		text-shadow: 2px 0 #ff4fd866, -2px 0 #40f4ff66;
	}

	.glitch-text {
		position: relative;
		isolation: isolate;
	}

	.glitch-text::before,
	.glitch-text::after {
		position: absolute;
		inset: 0;
		content: attr(data-glitch-text);
		opacity: 0;
		pointer-events: none;
	}

	.glitch-text::before {
		color: #40f4ff;
		text-shadow: 5px 0 #40f4ff;
		animation: hero-glitch-cyan 2.5s steps(1, end) infinite;
	}

	.glitch-text::after {
		color: #ff4fd8;
		text-shadow: -5px 0 #ff4fd8;
		animation: hero-glitch-magenta 3.8s steps(1, end) infinite;
	}

	@keyframes hero-glitch-cyan {
		0%,
		84%,
		100% {
			opacity: 0;
			transform: translate(0);
			clip-path: inset(0 0 100% 0);
		}
		85% {
			opacity: 1;
			transform: translate(8px, -2px) skewX(-2deg);
			clip-path: inset(6% 0 70% 0);
		}
		86% {
			opacity: 0.95;
			transform: translate(-6px, 1px) skewX(2deg);
			clip-path: inset(43% 0 33% 0);
		}
		88% {
			opacity: 1;
			transform: translate(5px, 2px) skewX(-1deg);
			clip-path: inset(74% 0 4% 0);
		}
		90% {
			opacity: 0.9;
			transform: translate(-8px, -1px);
			clip-path: inset(21% 0 55% 0);
		}
		93% {
			opacity: 0;
			transform: translate(0);
			clip-path: inset(0 0 100% 0);
		}
	}

	@keyframes hero-glitch-magenta {
		0%,
		84%,
		100% {
			opacity: 0;
			transform: translate(0);
			clip-path: inset(100% 0 0 0);
		}
		85% {
			opacity: 0.95;
			transform: translate(-8px, 1px) skewX(2deg);
			clip-path: inset(26% 0 48% 0);
		}
		87% {
			opacity: 1;
			transform: translate(7px, -2px) skewX(-2deg);
			clip-path: inset(62% 0 12% 0);
		}
		89% {
			opacity: 0.9;
			transform: translate(-5px, 2px);
			clip-path: inset(9% 0 70% 0);
		}
		91% {
			opacity: 1;
			transform: translate(8px, 0) skewX(1deg);
			clip-path: inset(38% 0 39% 0);
		}
		93% {
			opacity: 0;
			transform: translate(0);
			clip-path: inset(100% 0 0 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.glitch-text::before,
		.glitch-text::after {
			animation: none;
		}
	}
</style>