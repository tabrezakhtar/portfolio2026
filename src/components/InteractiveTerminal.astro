    };
    const renderPagerPage = () => {
      if (!pager) return;
      const start = pager.page * 8;
      const pageLines = pager.lines.slice(start, start + 8);
      pager.output.replaceChildren(
        ...pageLines.map((line) => createOutputLine(line)),
      );
      const status =
        pager.mode === "more"
          ? `--More-- (${Math.min(start + pageLines.length, pager.lines.length)}/${pager.lines.length}; Space/Enter next, q quit)`
          : `(page ${pager.page + 1}/${Math.max(1, Math.ceil(pager.lines.length / 8))}; Space/j/k/b navigate, q quit)`;
      pager.output.append(createOutputLine(status, "terminal-pager-status"));
      terminalScreen.scrollTop = terminalScreen.scrollHeight;
    };
    const closePager = () => {
      if (!pager) return;
      pager.output.querySelector(".terminal-pager-status")?.remove();
      pager = null;
