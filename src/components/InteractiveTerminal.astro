      terminalInput.focus({ preventScroll: true });
    };
    const pageForward = () => {
      if (!pager) return;
      const lastPage = Math.max(0, Math.ceil(pager.lines.length / 8) - 1);
      if (pager.page >= lastPage) {
        if (pager.mode === "more") closePager();
        else renderPagerPage();
        return;
      }
      pager.page += 1;
      renderPagerPage();
    };
    const pageBackward = () => {
      if (pager) {
        pager.page = Math.max(0, pager.page - 1);
        renderPagerPage();
