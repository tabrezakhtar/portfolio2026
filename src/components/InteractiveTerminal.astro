    };
    const commands: Partial<Record<string, (args: string[]) => string>> = {
      help: () =>
        "Commands: whoami, date, stack, projects, about, contact, party, invader.\nArchive: ls, cd, pwd, cat, more, less, head, tail, find, grep, tree, stat, wc, history, man.\nType man COMMAND for details. Press Tab for command and path completion.\nAlien research archive: /research. Fictional field notes; reported encounters are unverified.",
      pwd: () => nodePath(workingDirectory),
      ls: (args) => {
        const showAll =
          args.some((arg) => arg.startsWith("-") && arg.includes("a")) ||
          args.includes("--all");
        const long =
          args.some((arg) => arg.startsWith("-") && arg.includes("l")) ||
          args.includes("--long");
        const path = args.find((arg) => !arg.startsWith("-")) ?? ".";
        const paths = expandPaths([path]);
        if (path.includes("*") && paths.length === 1 && paths[0] === path)
          return `ls: ${path}: No such file or directory`;
        return paths
          .map((item) => listDirectory(item, showAll, long))
          .join("\n");
      },
      cd: (args) => {
        const path = args[0] ?? "/home/tabrez";
        const node = getNode(path);
        if (!node) return `cd: ${path}: No such file or directory`;
        if (node.type !== "directory") return `cd: ${path}: Not a directory`;
        workingDirectory = absolutePath(path);
        return "";
      },
      cat: (args) =>
        args.length
          ? expandPaths(args)
              .map((path) => {
                const result = readFile(path);
                return result.content ?? result.error ?? "";
              })
              .join("\n")
          : "cat: missing file operand",
      more: () => "",
      less: () => "",
      head: (args) => {
        let count = 10;
        const files = [...args];
        const option = files.indexOf("-n");
        if (option >= 0)
          ((count = Math.max(1, Number(files[option + 1]) || 10)),
            files.splice(option, 2));
        else if (files[0]?.match(/^-[0-9]+$/))
          count = Number(files.shift()?.slice(1));
        return expandPaths(files)
          .map((path) => {
            const result = readFile(path);
            return (
              result.error ??
              result.content?.split("\n").slice(0, count).join("\n") ??
              ""
            );
          })
          .join("\n");
      },
      tail: (args) => {
        let count = 10;
        const files = [...args];
        const option = files.indexOf("-n");
        if (option >= 0)
          ((count = Math.max(1, Number(files[option + 1]) || 10)),
            files.splice(option, 2));
        else if (files[0]?.match(/^-[0-9]+$/))
          count = Number(files.shift()?.slice(1));
        return expandPaths(files)
          .map((path) => {
            const result = readFile(path);
            return (
              result.error ??
              result.content?.split("\n").slice(-count).join("\n") ??
              ""
            );
          })
          .join("\n");
      },
      find: (args) => {
        const path = args[0] && !args[0].startsWith("-") ? args[0] : ".";
        const nameIndex = args.indexOf("-name");
        const pattern = nameIndex >= 0 ? args[nameIndex + 1] : "*";
        const matcher = new RegExp(
          `^${escapeRegExp(pattern).replace(/\\\*/g, ".*")}$`,
        );
        const node = getNode(path);
        if (!node) return `find: ${path}: No such file or directory`;
        const results =
          node.type === "file"
            ? [nodePath(absolutePath(path))]
            : [nodePath(absolutePath(path)), ...collectPaths(path)];
        return results
          .filter((item) => matcher.test(item.split("/").at(-1) ?? ""))
          .join("\n");
      },
      grep: (args) => {
        const insensitive =
          args.includes("-i") || args.includes("-in") || args.includes("-ni");
        const numbered =
          args.includes("-n") || args.includes("-in") || args.includes("-ni");
        const positional = args.filter((arg) => !arg.startsWith("-"));
        const pattern = positional.shift();
        if (!pattern || !positional.length)
          return "usage: grep [-in] PATTERN FILE...";
        const matcher = new RegExp(
          escapeRegExp(pattern),
          insensitive ? "i" : "",
        );
        return (
          expandPaths(positional)
            .flatMap((path) => {
              const result = readFile(path);
              if (result.error) return [result.error];
              return (result.content ?? "")
                .split("\n")
                .flatMap((line, index) =>
                  matcher.test(line)
                    ? [
                        `${positional.length > 1 ? `${path}:` : ""}${numbered ? `${index + 1}:` : ""}${line}`,
                      ]
                    : [],
                );
            })
            .join("\n") || "(no matches)"
        );
      },
      tree: (args) => {
        const path = args[0] ?? ".";
        const node = getNode(path);
        if (!node) return `tree: ${path}: No such file or directory`;
        const lines = [path];
        const walk = (item: FileNode, prefix: string) => {
          if (item.type !== "directory") return;
          const entries = Object.entries(item.children).sort(([a], [b]) =>
            a.localeCompare(b),
          );
          entries.forEach(([name, child], index) => {
            const last = index === entries.length - 1;
            lines.push(
              `${prefix}${last ? "└── " : "├── "}${name}${child.type === "directory" ? "/" : ""}`,
            );
            if (child.type === "directory")
              walk(child, `${prefix}${last ? "    " : "│   "}`);
          });
        };
        walk(node, "");
        return lines.join("\n");
      },
      stat: (args) =>
        args
          .map((path) => {
            const node = getNode(path);
            if (!node) return `stat: ${path}: No such file or directory`;
            return `  File: ${path}\n  Type: ${node.type}\n  Size: ${node.type === "file" ? node.content.length : Object.keys(node.children).length} bytes`;
          })
          .join("\n"),
      wc: (args) => {
        const flags = args
          .filter((arg) => /^-[lwc]+$/.test(arg))
          .join("")
          .replace(/-/g, "");
        const selected = flags ? [...new Set(flags)] : ["l", "w", "c"];
        const files = expandPaths(args.filter((arg) => !arg.startsWith("-")));
        return files
          .map((path) => {
            const result = readFile(path);
            if (result.error) return result.error;
            const content = result.content ?? "";
            const counts = {
              l: content.split("\n").length,
              w: content.trim() ? content.trim().split(/\s+/).length : 0,
              c: content.length,
            };
            return `${selected.map((flag) => counts[flag as keyof typeof counts]).join(" ")} ${path}`;
          })
          .join("\n");
      },
      history: () =>
        history.map((entry, index) => ` ${index + 1} ${entry}`).join("\n"),
      man: (args) => {
        const name = args[0];
        const descriptions: Record<string, string> = {
          ls: "list directory contents",
          cd: "change the current directory",
          pwd: "print the working directory",
          cat: "print file contents",
          more: "read a file one page at a time",
          less: "read a file with forward and backward paging",
          head: "print the first lines of a file",
          tail: "print the last lines of a file",
          find: "search the archive for files",
          grep: "search file contents for text",
          tree: "show a directory tree",
          stat: "show file or directory details",
          wc: "count lines, words, and bytes",
          invader: "play a small ASCII Space Invaders game",
        };
        return name && descriptions[name]
          ? `${name} - ${descriptions[name]}\n\nThis command operates on the simulated field archive.`
          : `No manual entry for ${name ?? "(command)"}`;
      },
      echo: (args) => args.join(" "),
      uname: () => "FieldOS terminal 1.0 (simulated) x86_64",
      whoami: () => "tabrez",
      date: () =>
        new Date().toLocaleString(undefined, {
          dateStyle: "medium",
          timeStyle: "medium",
          hourCycle: "h23",
        }),
      stack: () => "Node.js · Express · Next.js · TypeScript · JavaScript · React · MongoDB",
      invader: () => "",
      projects: () => {
        document.getElementById("work")?.scrollIntoView({ behavior: "smooth" });
        return "Opening selected work...";
      },
      about: () => {
        document
          .getElementById("about")
          ?.scrollIntoView({ behavior: "smooth" });
        return "Opening about.md...";
      },
      contact: () => {
        document
          .getElementById("contact")
          ?.scrollIntoView({ behavior: "smooth" });
        return "Opening contact.txt...";
      },
      party: () => {
        terminalWindow.classList.remove("is-party");
        void terminalWindow.offsetWidth;
        terminalWindow.classList.add("is-party");
        window.clearTimeout(partyTimer);
        partyBurst?.remove();
        partyBurst = document.createElement("div");
        partyBurst.className = "terminal-party-burst";
        partyBurst.setAttribute("aria-hidden", "true");
        const banner = document.createElement("pre");
        banner.className = "terminal-party-banner";
        banner.textContent =
          "+----------------------+\n|  >>> PARTY MODE <<<  |\n+----------------------+";
        partyBurst.append(banner);
        const symbols = ["*", "+", "x", ".", "o", "/", "\\", "|", "-", "="];
        const colors = ["#40f4ff", "#b9ff66", "#ff4fd8"];
        for (let index = 0; index < 52; index += 1) {
          const spark = document.createElement("span");
          spark.className = "terminal-party-spark";
          spark.textContent = symbols[index % symbols.length];
          const burstX = index < 26 ? 28 : 72;
          const burstY = index < 26 ? 32 : 68;
          spark.style.left = `${burstX + (Math.random() - 0.5) * 16}%`;
          spark.style.top = `${burstY + (Math.random() - 0.5) * 16}%`;
          spark.style.color = colors[index % colors.length];
          spark.style.setProperty(
            "--spark-x",
            `${Math.round((Math.random() - 0.5) * 230)}px`,
          );
          spark.style.setProperty(
            "--spark-y",
            `${Math.round((Math.random() - 0.5) * 170)}px`,
          );
          spark.style.animationDuration = `${900 + Math.random() * 600}ms`;
          spark.style.animationDelay = `${Math.random() * 160}ms`;
          partyBurst.append(spark);
        }
        terminalWindow.append(partyBurst);
        partyTimer = window.setTimeout(() => {
          terminalWindow.classList.remove("is-party");
          partyBurst?.remove();
          partyBurst = null;
        }, 1750);
        return "Neon protocol engaged. Nice moves.";
      },
      sudo: () =>
        "Permission denied: your taste is already dangerously powerful.",
    };

    const completionOptions: Record<string, string[]> = {
      cd: ["--"],
      find: ["-name"],
      grep: ["-i", "-n", "-in"],
      head: ["-n"],
      ls: ["-a", "-l", "-la", "--all", "--long"],
      tail: ["-n"],
      wc: ["-c", "-l", "-w", "-lw", "-lwc"],
    };
    const pathCompletionCommands = new Set([
      "cd",
      "ls",
      "cat",
      "more",
      "less",
      "head",
      "tail",
      "stat",
      "wc",
    ]);
    const commandNames = () => [...Object.keys(commands), "clear"].sort();
    const commonPrefix = (values: string[]) => {
      if (!values.length) return "";
      let prefix = values[0];
      for (const value of values.slice(1)) {
        let index = 0;
        while (
          index < prefix.length &&
          index < value.length &&
          prefix[index] === value[index]
        )
          index += 1;
        prefix = prefix.slice(0, index);
      }
      return prefix;
    };
    const completePath = (prefix: string) => {
      if (prefix === "~") return ["~/"];
      const slash = prefix.lastIndexOf("/");
      const directoryPrefix = slash < 0 ? "" : prefix.slice(0, slash + 1);
      const directoryPath = slash < 0 ? "." : prefix.slice(0, slash) || "/";
      const baseName = prefix.slice(slash + 1);
      const node = getNode(directoryPath);
      if (!node || node.type !== "directory") return [];
      return Object.entries(node.children)
        .filter(([name]) => name.startsWith(baseName))
        .map(
          ([name, child]) =>
            `${directoryPrefix}${name}${child.type === "directory" ? "/" : ""}`,
        )
        .sort((left, right) => left.localeCompare(right));
    };
    const completionCandidates = (
      beforeToken: string[],
      prefix: string,
    ): string[] => {
      if (!beforeToken.length)
        return commandNames().filter((name) => name.startsWith(prefix));

      const commandName = beforeToken[0].toLowerCase();
      const args = beforeToken.slice(1);
      if (commandName === "man")
        return commandNames().filter((name) => name.startsWith(prefix));
      if (prefix.startsWith("-"))
        return (completionOptions[commandName] ?? []).filter((option) =>
          option.startsWith(prefix),
        );

      if (commandName === "find" && args.includes("-name")) {
        const root = args.find((arg) => !arg.startsWith("-")) ?? ".";
        const node = getNode(root);
        if (!node) return [];
        const paths =
          node.type === "file"
            ? [nodePath(absolutePath(root))]
            : [root, ...collectPaths(root)];
        return [...new Set(paths.map((path) => path.split("/").at(-1) ?? ""))]
          .filter(Boolean)
          .filter((name) => name.startsWith(prefix))
          .sort();
      }

      if (
        pathCompletionCommands.has(commandName) ||
        (commandName === "grep" &&
          args.filter((arg) => !arg.startsWith("-")).length >= 1) ||
        commandName === "find"
      )
        return completePath(prefix);
      return [];
    };
    const showCompletions = (matches: string[]) => {
      const entry = document.createElement("div");
      entry.className = "terminal-entry terminal-completion-list";
      entry.append(createOutputLine(matches.join("    ")));
      appendTerminalEntry(entry);
    };
    const completeInput = () => {
      const value = terminalInput.value;
      const cursor = terminalInput.selectionStart ?? value.length;
      const selectionEnd = terminalInput.selectionEnd ?? cursor;
      const left = value.slice(0, cursor);
      const tokenStart = left.search(/\S*$/);
      const rawPrefix = left.slice(tokenStart);
      const quote =
        rawPrefix.startsWith('"') || rawPrefix.startsWith("'")
          ? rawPrefix[0]
          : "";
      const prefix = quote ? rawPrefix.slice(1) : rawPrefix;
      const beforeToken = tokenize(left.slice(0, tokenStart));
      const matches = completionCandidates(beforeToken, prefix);
      if (!matches.length) {
        lastTabValue = "";
        lastTabMatches = [];
        return;
      }

      const tokenEndMatch = value.slice(selectionEnd).match(/^\S*/);
      const tokenEnd = selectionEnd + (tokenEndMatch?.[0].length ?? 0);
      const multiple = matches.length > 1;
      const common = multiple ? commonPrefix(matches) : matches[0];
      const repeatedTab =
        value === lastTabValue &&
        matches.length === lastTabMatches.length &&
        matches.every((match, index) => match === lastTabMatches[index]);

      if (multiple && common.length <= prefix.length) {
        if (repeatedTab) showCompletions(matches);
        lastTabValue = value;
        lastTabMatches = matches;
        return;
      }

      const completion = multiple ? common : matches[0];
      const suffix = completion.endsWith("/") ? "" : quote ? quote : " ";
      const replacement = `${quote}${completion}${suffix}`;
      const nextValue =
        value.slice(0, tokenStart) + replacement + value.slice(tokenEnd);
      terminalInput.value = nextValue;
      const nextCursor = tokenStart + replacement.length;
      terminalInput.setSelectionRange(nextCursor, nextCursor);
      terminalTypedText.textContent = nextValue;
      lastTabValue = nextValue;
      lastTabMatches = matches;
    };

    const clearOutput = () => {
      terminalOutput.replaceChildren();
      terminalScreen.scrollTop = 0;
    };

    const appendTerminalEntry = (entry: HTMLDivElement) => {
      terminalOutput.append(entry);
      while (terminalOutput.querySelectorAll(".terminal-entry").length > 50) {
        terminalOutput.querySelector(".terminal-entry")?.remove();
      }
      terminalScreen.scrollTop = terminalScreen.scrollHeight;
    };

    terminalForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const line = terminalInput.value.trim();
      if (!line) {
        terminalInput.value = "";
        renderTypedText();
        const entry = document.createElement("div");
        entry.className = "terminal-entry terminal-entry-empty";
        const blankLine = document.createElement("p");
        blankLine.className = "terminal-empty-line";
        entry.append(blankLine);
        appendTerminalEntry(entry);
        return;
      }

      if (history.at(-1) !== line) history.push(line);
      if (history.length > 30) history.shift();
      historyIndex = history.length;
      draft = "";

      const [name, ...args] = tokenize(line);
      const commandPromptPath = displayPath(workingDirectory);
      const commandName = name.toLowerCase();
      if (commandName === "clear") {
        clearOutput();
        terminalInput.value = "";
        renderTypedText();
        return;
      }

      const command = commands[commandName];
      const pagerMode =
        commandName === "more" || commandName === "less" ? commandName : null;
      const pagerFile = pagerMode && args[0] ? readFile(args[0]) : null;
      if (
        pagerMode &&
        pagerFile &&
        !pagerFile.error &&
        pagerFile.content !== undefined
      ) {
        const commandEntry = document.createElement("div");
        commandEntry.className = "terminal-entry";
        commandEntry.append(
          createOutputLine(
            `tabrez@localhost:${commandPromptPath}$ ${line}`,
            "terminal-entry-command",
          ),
        );
        appendTerminalEntry(commandEntry);
        openPager(pagerMode, args[0], pagerFile.content);
        terminalInput.value = "";
        renderTypedText();
        return;
      }
      const response = pagerMode
        ? (pagerFile?.error ?? `usage: ${pagerMode} FILE`)
        : (command?.(args) ?? `zsh: command not found: ${name}`);
      terminalForm.querySelector<HTMLElement>(
        "[data-terminal-path]",
      )!.textContent = displayPath(workingDirectory);
      const entry = document.createElement("div");
      entry.className = "terminal-entry";
      const commandLine = document.createElement("p");
      commandLine.className = "terminal-entry-command";
      commandLine.textContent = `tabrez@localhost:${commandPromptPath}$ ${line}`;
      entry.append(commandLine);
      if (response) {
        const responseLine = document.createElement("p");
        responseLine.className =
          command || pagerMode
            ? "terminal-entry-response"
            : "terminal-entry-error";
        responseLine.textContent = response;
        entry.append(responseLine);
      }
      appendTerminalEntry(entry);
      terminalInput.value = "";
      renderTypedText();
      if (commandName === "invader") {
        terminalScreen.classList.add("is-invader-active");
        terminalForm.hidden = true;
        if (invaderTrigger) invaderTrigger.disabled = true;
        const game = createInvaderGame(() => {
          terminalScreen.classList.remove("is-invader-active");
          terminalForm.hidden = false;
          terminalInput.focus({ preventScroll: true });
          if (invaderTrigger) invaderTrigger.disabled = false;
        });
        appendTerminalEntry(game);
        game.focus({ preventScroll: true });
        return;
      }
    });

    document.addEventListener(
      "keydown",
      (event) => {
        if (pager) {
          const key = event.key.toLowerCase();
          if (key === "q" || key === "escape") closePager();
          else if (
            key === " " ||
            key === "enter" ||
            key === "pagedown" ||
            key === "j" ||
            key === "arrowdown"
          )
            pageForward();
          else if (
            key === "b" ||
            key === "k" ||
            key === "pageup" ||
            key === "arrowup"
          )
            pageBackward();
          else {
            event.preventDefault();
            return;
          }
          event.preventDefault();
          return;
        }
        if (
          document.activeElement === terminalInput ||
          event.isComposing ||
          event.ctrlKey ||
          event.metaKey ||
          event.altKey ||
          event.key.length !== 1
        )
          return;
        const activeElement = document.activeElement;
        if (
          activeElement instanceof HTMLElement &&
          (activeElement.isContentEditable ||
            activeElement.closest("[data-invader-game]") ||
            activeElement.matches('input, textarea, select, [role="textbox"]'))
        )
          return;

        event.preventDefault();
        terminalInput.focus({ preventScroll: true });
        terminalInput.value += event.key;
        terminalInput.setSelectionRange(
          terminalInput.value.length,
          terminalInput.value.length,
        );
        renderTypedText();
      },
      true,
    );

    terminalInput.addEventListener("keydown", (event) => {
      if (event.key === "Tab") {
        event.preventDefault();
        completeInput();
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        if (historyIndex === history.length) draft = terminalInput.value;
        historyIndex = Math.max(0, historyIndex - 1);
        terminalInput.value = history[historyIndex] ?? draft;
        renderTypedText();
      } else if (event.key === "ArrowDown") {
        event.preventDefault();
        historyIndex = Math.min(history.length, historyIndex + 1);
        terminalInput.value =
          historyIndex === history.length
            ? draft
            : (history[historyIndex] ?? "");
        renderTypedText();
      } else if (
        (event.ctrlKey || event.metaKey) &&
        event.key.toLowerCase() === "l"
      ) {
        event.preventDefault();
        clearOutput();
      }
    });
  }
</script>

