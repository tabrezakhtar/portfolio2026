<div class="interactive-terminal-pane terminal-pane terminal-pane--status">
    <div class="pane-title"><span>pane 0.2</span><span>~/status</span></div>
    <div class="status-output">
        <div
            class="terminal-transcript"
            data-terminal-output
            aria-live="polite"
            aria-relevant="additions text"
        >
            <p>
                <span class="prompt-symbol">❯</span> git status --short --branch
            </p>
            <p>
                <span class="status-branch">##</span> main <span
                    class="status-clean">● working tree clean</span
                >
            </p>
            <p><span class="prompt-symbol">❯</span> cat stack.txt</p>
            <p class="stack-list">
                TypeScript <span>·</span> React <span>·</span> Astro <span
                    >·</span
                > CSS
            </p>
        </div>
        <form class="terminal-command" data-terminal-form>
            <p class="terminal-prompt-line">
                <span class="prompt-symbol">❯</span> tabrez@localhost:<span
                    data-terminal-path>/</span
                >$ <span data-typed-text></span><span
                    class="terminal-cursor"
                    aria-hidden="true"></span>
            </p>
            <input
                id="terminal-input"
                class="terminal-sr-input"
                name="command"
                type="text"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                aria-label="Terminal command"
            />
        </form>
    </div>
</div>

<script>
