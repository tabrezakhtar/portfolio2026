    if (filesystem.type === "directory") {
      const researchFolder = filesystem.children.research;
      if (researchFolder?.type === "directory") {
        const alienArchive = researchFolder.children.aliens;
        if (alienArchive?.type === "directory") {
          researchFolder.children = alienArchive.children;
        }
      }
    }
    let workingDirectory: string[] = [];
    let pager: PagerState | null = null;
    const tokenize = (value: string) =>
      [...value.matchAll(/"([^"]*)"|'([^']*)'|(\S+)/g)].map(
        (match) => match[1] ?? match[2] ?? match[3],
      );
    const absolutePath = (path: string) => {
      const expandedPath =
        path === "~"
          ? "/home/tabrez"
          : path.startsWith("~/")
            ? `/home/tabrez/${path.slice(2)}`
            : path;
      const parts = expandedPath.startsWith("/") ? [] : [...workingDirectory];
      for (const part of expandedPath.split("/")) {
        if (!part || part === ".") continue;
        if (part === "..") parts.pop();
        else parts.push(part);
      }
      return parts;
    };
    const getNode = (path: string): FileNode | null => {
      let node: FileNode = filesystem;
      for (const part of absolutePath(path)) {
        if (node.type !== "directory" || !node.children[part]) return null;
        node = node.children[part];
      }
      return node;
    };
    const nodePath = (parts: string[]) => `/${parts.join("/")}`;
    const displayPath = (parts: string[]) =>
      nodePath(parts).replace(/^\/home\/tabrez$/, "~");
    const escapeRegExp = (value: string) =>
      value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const expandPaths = (patterns: string[]) =>
      patterns.flatMap((pattern) => {
        if (!pattern.includes("*")) return [pattern];
        const slash = pattern.lastIndexOf("/");
        const directoryPath = slash < 0 ? "." : pattern.slice(0, slash) || "/";
        const filePattern = pattern.slice(slash + 1);
        const node = getNode(directoryPath);
        if (!node || node.type !== "directory") return [pattern];
        const matcher = new RegExp(
          `^${escapeRegExp(filePattern).replace(/\\\*/g, ".*")}$`,
        );
        return Object.keys(node.children)
          .filter((name) => matcher.test(name))
          .map(
            (name) =>
              `${directoryPath === "/" ? "" : directoryPath.replace(/\/$/, "")}/${name}` ||
              `/${name}`,
          );
      });
    const readFile = (path: string) => {
      const node = getNode(path);
      if (!node) return { error: `cat: ${path}: No such file or directory` };
      if (node.type !== "file")
        return { error: `cat: ${path}: Is a directory` };
      return { content: node.content };
    };
    const listDirectory = (path: string, showAll: boolean, long: boolean) => {
      const node = getNode(path);
      if (!node) return `ls: ${path}: No such file or directory`;
      if (node.type === "file") return path;
      const names = Object.keys(node.children).sort();
      return (showAll ? [".", "..", ...names] : names)
        .map((name) => {
          const child = node.children[name];
          if (name === "." || name === "..")
            return long
              ? `drwxr-xr-x 2 tabrez staff 0 Jan 01 00:00 ${name}`
              : name;
          const entry = child.type === "directory" ? `${name}/` : name;
          return long
            ? `${child.type === "directory" ? "drwxr-xr-x" : "-rw-r--r--"} 1 tabrez staff ${child.type === "file" ? child.content.length : 0} Jan 01 00:00 ${entry}`
            : entry;
        })
        .join("\n");
    };
    const collectPaths = (
      path: string,
      base: string[] = absolutePath(path),
    ): string[] => {
      const node = getNode(path);
      if (!node) return [];
      if (node.type === "file") return [nodePath(base)];
      return Object.entries(node.children).flatMap(([name, child]) => {
        const childPath = [...base, name];
        return [
          nodePath(childPath),
          ...(child.type === "directory"
            ? collectPaths(nodePath(childPath), childPath)
            : []),
        ];
      });
    };
    const createOutputLine = (text: string, className = "") => {
      const line = document.createElement("p");
      if (className) line.className = className;
      line.textContent = text || " ";
      return line;
    };
    const openPager = (
      mode: "more" | "less",
      path: string,
      content: string,
    ) => {
      const output = document.createElement("div");
      output.className = "terminal-entry terminal-pager";
      output.dataset.file = path;
      pager = { mode, lines: content.split("\n"), page: 0, output };
