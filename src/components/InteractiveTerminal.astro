      var: directory({
        log: directory({
          "system.log": textFile(
            `03:00 notes terminal online\n03:04 full stack notes indexed\n03:12 ROM catalogue loaded\n03:16 music theory notes indexed\n03:20 Stratocaster guides loaded\n03:25 practice logs indexed\n03:30 terminal ready`,
