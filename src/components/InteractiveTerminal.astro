<div class="interactive-terminal-pane terminal-pane terminal-pane--status">
	<div class="pane-title"><span>pane 0.2</span><span>~/status</span></div>
	<div class="status-output">
		<div class="terminal-transcript" data-terminal-output aria-live="polite" aria-relevant="additions text">
			<p><span class="prompt-symbol">❯</span> git status --short --branch</p>
			<p><span class="status-branch">##</span> main <span class="status-clean">● working tree clean</span></p>
			<p><span class="prompt-symbol">❯</span> cat stack.txt</p>
			<p class="stack-list">TypeScript <span>·</span> React <span>·</span> Astro <span>·</span> CSS</p>
		</div>
		<form class="terminal-command" data-terminal-form>
			<label for="terminal-input"><span class="prompt-symbol">❯</span> tabrez@localhost:~$ <span class="terminal-cursor" aria-hidden="true"></span></label>
			<input id="terminal-input" name="command" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="try help" aria-label="Terminal command" />
		</form>
	</div>
</div>

<script>
	const terminalForm = document.querySelector<HTMLFormElement>('[data-terminal-form]');
	const terminalInput = terminalForm?.querySelector<HTMLInputElement>('input');
	const terminalOutput = document.querySelector<HTMLElement>('[data-terminal-output]');
	const terminalScreen = terminalForm?.closest<HTMLElement>('.status-output');
	const terminalWindow = terminalForm?.closest<HTMLElement>('.terminal-window');
	if (terminalForm && terminalInput && terminalOutput && terminalScreen && terminalWindow) {
		const history: string[] = [];
		let historyIndex = 0;
		let draft = '';
		let partyTimer = 0;
		let partyBurst: HTMLDivElement | null = null;
		const commands: Partial<Record<string, () => string>> = {
			help: () => 'Try: whoami, date, stack, projects, about, contact, party, clear',
			whoami: () => 'Tabrez: full-stack engineer, interface tinkerer, professional human.',
			date: () => new Date().toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'medium', hourCycle: 'h23' }),
			stack: () => 'TypeScript · React · Astro · CSS',
			projects: () => {
				document.getElementById('work')?.scrollIntoView({ behavior: 'smooth' });
				return 'Opening selected work...';
			},
			about: () => {
				document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' });
				return 'Opening about.md...';
			},
			contact: () => {
				document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
				return 'Opening contact.txt...';
			},
			party: () => {
				terminalWindow.classList.remove('is-party');
				void terminalWindow.offsetWidth;
				terminalWindow.classList.add('is-party');
				window.clearTimeout(partyTimer);
				partyBurst?.remove();
				partyBurst = document.createElement('div');
				partyBurst.className = 'terminal-party-burst';
				partyBurst.setAttribute('aria-hidden', 'true');
				const banner = document.createElement('pre');
				banner.className = 'terminal-party-banner';
				banner.textContent = '+----------------------+\n|  >>> PARTY MODE <<<  |\n+----------------------+';
				partyBurst.append(banner);
				const symbols = ['*', '+', 'x', '.', 'o', '/', '\\', '|', '-', '='];
				const colors = ['#40f4ff', '#b9ff66', '#ff4fd8'];
				for (let index = 0; index < 52; index += 1) {
					const spark = document.createElement('span');
					spark.className = 'terminal-party-spark';
					spark.textContent = symbols[index % symbols.length];
					const burstX = index < 26 ? 28 : 72;
					const burstY = index < 26 ? 32 : 68;
					spark.style.left = `${burstX + (Math.random() - 0.5) * 16}%`;
					spark.style.top = `${burstY + (Math.random() - 0.5) * 16}%`;
					spark.style.color = colors[index % colors.length];
					spark.style.setProperty('--spark-x', `${Math.round((Math.random() - 0.5) * 230)}px`);
					spark.style.setProperty('--spark-y', `${Math.round((Math.random() - 0.5) * 170)}px`);
					spark.style.animationDuration = `${900 + Math.random() * 600}ms`;
					spark.style.animationDelay = `${Math.random() * 160}ms`;
					partyBurst.append(spark);
				}
				terminalWindow.append(partyBurst);
				partyTimer = window.setTimeout(() => {
					terminalWindow.classList.remove('is-party');
					partyBurst?.remove();
					partyBurst = null;
				}, 1750);
				return 'Neon protocol engaged. Nice moves.';
			},
			sudo: () => 'Permission denied: your taste is already dangerously powerful.',
		};

		const clearOutput = () => {
			terminalOutput.replaceChildren();
			terminalScreen.scrollTop = 0;
		};

		terminalForm.addEventListener('submit', (event) => {
			event.preventDefault();
			const line = terminalInput.value.trim();
			if (!line) return;

			if (history.at(-1) !== line) history.push(line);
			if (history.length > 30) history.shift();
			historyIndex = history.length;
			draft = '';

			const [name] = line.split(/\s+/);
			if (name.toLowerCase() === 'clear') {
				clearOutput();
				terminalInput.value = '';
				return;
			}

			const command = commands[name.toLowerCase()];
			const response = command?.() ?? `zsh: command not found: ${name}`;
			const entry = document.createElement('div');
			entry.className = 'terminal-entry';
			const commandLine = document.createElement('p');
			commandLine.className = 'terminal-entry-command';
			commandLine.textContent = `tabrez@localhost:~$ ${line}`;
			const responseLine = document.createElement('p');
			responseLine.className = command ? 'terminal-entry-response' : 'terminal-entry-error';
			responseLine.textContent = response;
			entry.append(commandLine, responseLine);
			terminalOutput.append(entry);
			while (terminalOutput.querySelectorAll('.terminal-entry').length > 50) {
				terminalOutput.querySelector('.terminal-entry')?.remove();
			}
			terminalScreen.scrollTop = terminalScreen.scrollHeight;
			terminalInput.value = '';
		});

		document.addEventListener('keydown', (event) => {
			if (document.activeElement === terminalInput || event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey || event.key.length !== 1) return;
			const activeElement = document.activeElement;
			if (activeElement instanceof HTMLElement && (activeElement.isContentEditable || activeElement.matches('input, textarea, select, button, a[href], [role="button"], [tabindex]'))) return;

			event.preventDefault();
			terminalInput.focus();
			terminalInput.value += event.key;
			terminalInput.setSelectionRange(terminalInput.value.length, terminalInput.value.length);
		});

		terminalInput.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowUp') {
				event.preventDefault();
				if (historyIndex === history.length) draft = terminalInput.value;
				historyIndex = Math.max(0, historyIndex - 1);
				terminalInput.value = history[historyIndex] ?? draft;
			} else if (event.key === 'ArrowDown') {
				event.preventDefault();
				historyIndex = Math.min(history.length, historyIndex + 1);
				terminalInput.value = historyIndex === history.length ? draft : history[historyIndex] ?? '';
			} else if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'l') {
				event.preventDefault();
				clearOutput();
			}
		});
	}
</script>

<style is:global>
	.interactive-terminal-pane {
		min-width: 0;
		overflow: hidden;
		border: 1px solid #413052;
		background: #100e1d;
		grid-column: 1 / -1;
	}

	.interactive-terminal-pane .pane-title {
		min-height: 27px;
		padding: 0 10px;
		border-bottom: 1px solid #38294b;
		background: #171326;
		color: #847499;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font: 9px 'Space Mono', monospace;
	}

	.interactive-terminal-pane .pane-title span:first-child {
		color: #40f4ff;
	}

	.interactive-terminal-pane .status-output {
		height: 180px;
		min-height: 180px;
		max-height: 180px;
		padding: 8px 17px;
		display: flex;
		flex-direction: column;
		gap: 4px;
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		color: #c1b6d2;
		font: 9px 'Space Mono', monospace;
	}

	.interactive-terminal-pane .status-output p {
		margin: 0;
	}

	.interactive-terminal-pane .terminal-transcript {
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: 9px;
		white-space: pre-wrap;
	}

	.interactive-terminal-pane .terminal-entry {
		display: grid;
		gap: 4px;
	}

	.interactive-terminal-pane .terminal-entry-command,
	.interactive-terminal-pane .terminal-entry-response,
	.interactive-terminal-pane .terminal-entry-error {
		margin: 0;
	}

	.interactive-terminal-pane .terminal-entry-command {
		color: #8d7eaa;
	}

	.interactive-terminal-pane .terminal-entry-response {
		color: #40f4ff;
	}

	.interactive-terminal-pane .terminal-entry-error {
		color: #ff7b86;
	}

	.interactive-terminal-pane .terminal-command {
		min-width: 0;
		margin-top: auto;
		display: flex;
		align-items: center;
		gap: 8px;
		color: #c1b6d2;
		font-size: 9px;
	}

	.interactive-terminal-pane .terminal-command label {
		flex: 0 0 auto;
	}

	.interactive-terminal-pane .terminal-cursor {
		display: inline-block;
		width: 6px;
		height: 10px;
		background: #b9ff66;
		vertical-align: -1px;
		animation: terminal-cursor-blink 1s steps(2, start) infinite;
	}

	.interactive-terminal-pane .terminal-command:focus-within .terminal-cursor {
		visibility: hidden;
	}

	@keyframes terminal-cursor-blink {
		to {
			visibility: hidden;
		}
	}

	.interactive-terminal-pane .terminal-command input {
		min-width: 0;
		flex: 1;
		padding: 3px 0;
		border: 0;
		border-bottom: 1px solid transparent;
		border-radius: 0;
		outline: 0;
		background: transparent;
		color: #f6f1ff;
		font: inherit;
		caret-color: #b9ff66;
	}

	.interactive-terminal-pane .terminal-command input::placeholder {
		color: #716780;
	}

	.interactive-terminal-pane .terminal-command input:focus-visible {
		border-bottom-color: #b9ff66;
	}

	.interactive-terminal-pane .prompt-symbol,
	.interactive-terminal-pane .status-branch {
		color: #ff4fd8;
	}

	.interactive-terminal-pane .status-clean,
	.interactive-terminal-pane .stack-list span {
		color: #b9ff66;
	}

	.interactive-terminal-pane .stack-list {
		color: #40f4ff;
	}

	.terminal-window.is-party {
		animation: terminal-party 220ms steps(2, end) 5;
	}

	.terminal-party-burst {
		position: absolute;
		inset: 0;
		z-index: 3;
		overflow: hidden;
		pointer-events: none;
	}

	.terminal-party-spark {
		position: absolute;
		z-index: 1;
		font-family: 'Space Mono', monospace;
		font-size: 14px;
		font-weight: 700;
		text-shadow: 0 0 9px currentColor;
		animation: party-spark 1050ms cubic-bezier(0.15, 0.7, 0.3, 1) both;
	}

	.terminal-party-banner {
		position: absolute;
		z-index: 2;
		top: 50%;
		left: 50%;
		margin: 0;
		color: #b9ff66;
		font-family: 'Space Mono', monospace;
		font-size: 11px;
		line-height: 1.5;
		text-align: center;
		text-shadow: 0 0 12px #b9ff66a0;
		transform: translate(-50%, -50%);
		animation: party-banner 1500ms ease-out both;
	}

	@keyframes terminal-party {
		50% {
			border-color: #b9ff66;
			box-shadow: 0 0 0 1px #b9ff6640, 0 0 22px #40f4ff65;
		}
	}

	@keyframes party-spark {
		0% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(0.25) rotate(0deg);
		}
		15% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			transform: translate(calc(-50% + var(--spark-x)), calc(-50% + var(--spark-y))) scale(1.35) rotate(180deg);
		}
	}

	@keyframes party-banner {
		0% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(0.55);
		}
		15%,
		68% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1);
		}
		100% {
			opacity: 0;
			transform: translate(-50%, -65%) scale(1.08);
		}
	}

	@media (max-width: 900px) {
		.interactive-terminal-pane .status-output {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.interactive-terminal-pane .status-output {
			padding-right: 10px;
			padding-left: 10px;
			font-size: 8px;
		}
	}
</style>
