  const terminalWindow = terminalForm?.closest<HTMLElement>(".terminal-window");
  const invaderTrigger = document.querySelector<HTMLButtonElement>(
    "[data-invader-trigger]",
  );
  if (
    terminalForm &&
    terminalInput &&
    terminalTypedText &&
    terminalOutput &&
    terminalScreen &&
    terminalWindow
  ) {
    const renderTypedText = () => {
      lastTabValue = "";
      lastTabMatches = [];
      terminalTypedText.textContent = terminalInput.value;
    };
    terminalInput.addEventListener("input", renderTypedText);
    terminalScreen.addEventListener("click", () =>
      terminalInput.focus({ preventScroll: true }),
    );
    invaderTrigger?.addEventListener("click", () => {
      terminalInput.value = "invader";
      renderTypedText();
      terminalForm.requestSubmit();
    });
    const history: string[] = [];
    let historyIndex = 0;
    let draft = "";
    let lastTabValue = "";
    let lastTabMatches: string[] = [];
    let partyTimer = 0;
    let partyBurst: HTMLDivElement | null = null;
    type FileNode =
      | { type: "file"; content: string }
      | { type: "directory"; children: Record<string, FileNode> };
    type DirectoryNode = Extract<FileNode, { type: "directory" }>;
    type PagerState = {
      mode: "more" | "less";
      lines: string[];
      page: number;
      output: HTMLDivElement;
    };
    const directory = (children: Record<string, FileNode>): DirectoryNode => ({
      type: "directory",
      children,
    });
    const textFile = (content: string): FileNode => ({
      type: "file",
      content,
    });
const filesystem = directory({
      home: directory({
        tabrez: directory({
          "README.txt": textFile(
            `DEV NOTES TERMINAL\n==================\n\nWelcome to my personal notes archive.\n\nThis terminal contains full stack development notes, my retro ROM collection catalogue, music theory notes and Fender Stratocaster setup and repair guides.\n\nStart with:\nls /notes\nls /roms\nls /music`,
          ),
          "stack.txt": textFile(
            `JavaScript\nTypeScript\nNode.js\nExpress\nNext.js\nMongoDB\nReact\nAstro\nSSR\nCSS`,
          ),
        }),
      }),
      notes: directory({
        "README.md": textFile(
          `FULL STACK DEVELOPMENT NOTES\n============================\n\nMy personal notes, cheat sheets and reminders.\n\nStack: JavaScript, TypeScript, Node, Express, Next.js, MongoDB, React, Astro, SSR.\n\nSections:\n- javascript/   language fundamentals\n- typescript/   types, generics, config\n- node/         runtime, streams, tooling\n- express/      APIs, middleware, auth\n- nextjs/       app router, RSC, caching\n- react/        hooks, patterns, performance\n- astro/        islands, content, SSR\n- ssr/          rendering strategies\n- mongodb/      queries, indexes, schema design\n- tools/        git, docker, terminal\n\nThese are notes for me, written as I learn. Some are half finished.\n\nTry: ls javascript/\nfind . -name "*.log"`,
        ),
        "dev-log.log": textFile(
          `2026-01-05  19:30  Finished reading the Next.js app router docs end to end.\n2026-01-12  20:10  Rebuilt the portfolio site in Astro. Lighthouse score 100.\n2026-01-26  18:45  Learned MongoDB aggregation pipelines properly. $lookup is not scary.\n2026-02-09  21:00  Refactored Express routes into controllers and services.\n2026-02-23  19:15  Added zod validation to every API route.\n2026-03-04  20:30  Server components finally clicked. Fetch on the server, pass props down.\n2026-03-18  22:00  Fixed a hydration mismatch caused by Date.now() in render.\n2026-04-02  19:40  Set up compound indexes. Query time dropped from 900ms to 12ms.\n2026-04-20  20:05  Wrote custom hooks for debounce and local storage.\n2026-05-11  18:50  Moved auth to httpOnly cookies. No more tokens in localStorage.\n2026-06-03  21:20  Deployed Astro SSR with the Node adapter behind nginx.\n2026-07-14  19:00  Streaming SSR with Suspense in Next.js. Feels fast.\n\nTODO: write up caching notes properly.`,
        ),
        javascript: directory({
          "closures.txt": textFile(
            `CLOSURES\n========\n\nA closure is a function that remembers the variables from the scope where it was created, even after that scope has finished running.\n\nconst makeCounter = () => {\n  let count = 0;\n  return () => ++count;\n};\n\nconst next = makeCounter();\nnext(); // 1\nnext(); // 2\n\nUses:\n- Private state\n- Function factories\n- Memoisation\n- Debounce and throttle\n- Event handlers that need context\n\nGotcha: var shares one binding across a loop. let creates a fresh binding per iteration.`,
          ),
          "promises-async.txt": textFile(
            `PROMISES AND ASYNC/AWAIT\n========================\n\nA promise is pending, fulfilled or rejected.\n\nasync function getUser(id) {\n  try {\n    const res = await fetch("/api/users/" + id);\n    if (!res.ok) throw new Error("HTTP " + res.status);\n    return await res.json();\n  } catch (err) {\n    console.error(err);\n    throw err;\n  }\n}\n\nRun things in parallel:\nconst [a, b] = await Promise.all([getA(), getB()]);\n\nOther helpers:\n- Promise.allSettled: never rejects, reports every result\n- Promise.race: first to settle wins\n- Promise.any: first to fulfil wins\n\nRemember: fetch does not reject on 404 or 500. Always check res.ok.\nAvoid await inside a forEach. Use for...of or Promise.all with map.`,
          ),
          "event-loop.txt": textFile(
            `THE EVENT LOOP\n==============\n\nJavaScript is single threaded. Async work is handled by the runtime and queued.\n\nOrder of execution:\n1. Synchronous code on the call stack\n2. Microtasks (promise callbacks, queueMicrotask)\n3. Macrotasks (setTimeout, setInterval, I/O, UI events)\n\nconsole.log("A");\nsetTimeout(() => console.log("B"), 0);\nPromise.resolve().then(() => console.log("C"));\nconsole.log("D");\n\nOutput: A D C B\n\nLong synchronous loops block everything, including rendering. Break up heavy work or move it to a worker.`,
          ),
          "array-methods.txt": textFile(
            `ARRAY METHODS CHEAT SHEET\n=========================\n\nmap        transform every item, returns new array\nfilter     keep items that pass a test\nreduce     fold into a single value\nfind       first match or undefined\nfindIndex  index of first match\nsome       true if any item passes\nevery      true if all items pass\nflat       flatten nested arrays\nflatMap    map then flatten one level\nat         negative indexing, arr.at(-1)\ntoSorted   sorted copy, does not mutate\ntoReversed reversed copy\nObject.groupBy(items, fn) groups items by key\n\nconst total = items.reduce((sum, i) => sum + i.price, 0);\nconst names = users.filter(u => u.active).map(u => u.name);\n\nsort mutates the original and sorts as strings by default. Always pass a comparator: arr.sort((a, b) => a - b).`,
          ),
          "es-modules.txt": textFile(
            `ES MODULES\n==========\n\nNamed exports:\nexport const add = (a, b) => a + b;\nimport { add } from "./math.js";\n\nDefault export:\nexport default function App() {}\nimport App from "./App.js";\n\nDynamic import:\nconst mod = await import("./heavy.js");\n\nIn Node, set "type": "module" in package.json or use the .mjs extension.\nImports need the file extension in Node ESM.\n\n__dirname is not available in ESM:\nimport { fileURLToPath } from "node:url";\nimport path from "node:path";\nconst __dirname = path.dirname(fileURLToPath(import.meta.url));\n\nTop level await works in modules.`,
          ),
          "destructuring-spread.txt": textFile(
            `DESTRUCTURING, SPREAD AND REST\n==============================\n\nconst { name, age = 18, ...rest } = user;\nconst [first, , third] = list;\n\nSpread copies (shallowly):\nconst next = { ...state, loading: false };\nconst merged = [...a, ...b];\n\nRest collects arguments:\nfunction sum(...nums) { return nums.reduce((a, b) => a + b, 0); }\n\nOptional chaining and nullish coalescing:\nconst city = user?.address?.city ?? "Unknown";\n\n?? only falls back on null or undefined. || falls back on any falsy value (0, "", false).\n\nDeep copy: structuredClone(obj).`,
          ),
          "this-and-prototypes.txt": textFile(
            `THIS AND PROTOTYPES\n===================\n\nthis depends on how a function is called, not where it is defined.\n\n- Method call: this is the object before the dot\n- Plain function call: undefined in strict mode\n- Arrow function: inherits this from the surrounding scope\n- call, apply, bind set this explicitly\n\nClasses are syntax over prototypes.\nclass Dog extends Animal {\n  #secret = 1;\n  speak() { return "woof"; }\n}\n\nPrefer composition over deep inheritance.`,
          ),
        }),
        typescript: directory({
          "basics.txt": textFile(
            `TYPESCRIPT BASICS\n=================\n\nlet id: number = 1;\nlet name: string = "Tabrez";\nlet tags: string[] = [];\nlet pair: [string, number] = ["a", 1];\n\ntype User = {\n  id: string;\n  name: string;\n  email?: string;\n};\n\nfunction greet(user: User): string {\n  return "Hello " + user.name;\n}\n\nunknown is the safe version of any. Narrow it before use.\nnever means a value that cannot happen. Useful for exhaustive checks.\nsatisfies checks a value against a type without widening it.`,
          ),
          "generics.txt": textFile(
            `GENERICS\n========\n\nfunction first<T>(items: T[]): T | undefined {\n  return items[0];\n}\n\nConstraints:\nfunction getKey<T, K extends keyof T>(obj: T, key: K): T[K] {\n  return obj[key];\n}\n\nGeneric types:\ntype ApiResponse<T> = {\n  data: T;\n  error?: string;\n};\n\nDefaults:\ntype Paged<T = unknown> = { items: T[]; total: number };\n\nRule of thumb: if a type parameter is only used once, you probably do not need it.`,
          ),
          "utility-types.txt": textFile(
            `UTILITY TYPES\n=============\n\nPartial<T>        all properties optional\nRequired<T>       all properties required\nReadonly<T>       all properties readonly\nPick<T, K>        keep only keys K\nOmit<T, K>        remove keys K\nRecord<K, V>      object with keys K and values V\nExclude<U, X>     remove X from a union\nExtract<U, X>     keep only X in a union\nNonNullable<T>    remove null and undefined\nReturnType<F>     return type of a function\nParameters<F>     tuple of parameter types\nAwaited<T>        unwrap a promise type\n\ntype UserPreview = Pick<User, "id" | "name">;\ntype UpdateUser = Partial<Omit<User, "id">>;`,
          ),
          "narrowing.txt": textFile(
            `TYPE NARROWING\n==============\n\ntypeof:\nif (typeof value === "string") { value.toUpperCase(); }\n\nin operator:\nif ("radius" in shape) { shape.radius; }\n\nDiscriminated unions:\ntype Result =\n  | { ok: true; data: string }\n  | { ok: false; error: string };\n\nfunction handle(r: Result) {\n  if (r.ok) return r.data;\n  return r.error;\n}\n\nCustom type guard:\nfunction isUser(x: unknown): x is User {\n  return typeof x === "object" && x !== null && "id" in x;\n}\n\nExhaustive switch:\ndefault: {\n  const _check: never = value;\n  return _check;\n}`,
          ),
          "tsconfig.txt": textFile(
            `TSCONFIG NOTES\n==============\n\nA sensible strict base:\n{\n  "compilerOptions": {\n    "target": "ES2022",\n    "module": "ESNext",\n    "moduleResolution": "Bundler",\n    "strict": true,\n    "noUncheckedIndexedAccess": true,\n    "esModuleInterop": true,\n    "skipLibCheck": true,\n    "resolveJsonModule": true,\n    "isolatedModules": true,\n    "paths": { "@/*": ["./src/*"] }\n  },\n  "include": ["src"]\n}\n\nNode projects: module NodeNext and moduleResolution NodeNext.\nNext.js and Astro ship their own base configs. Extend them instead of starting from scratch.`,
          ),
          "types-vs-interfaces.txt": textFile(
            `TYPE VS INTERFACE\n=================\n\nBoth describe object shapes.\n\ninterface: can be extended and merged (declaration merging). Good for public object contracts and class shapes.\ntype: can describe unions, intersections, tuples, mapped and conditional types.\n\nMy rule: use type by default, interface when I need extends or merging.\n\nBe consistent inside a project.`,
          ),
          "zod-validation.txt": textFile(
            `RUNTIME VALIDATION WITH ZOD\n===========================\n\nTypes disappear at runtime. Validate anything that crosses a boundary: request bodies, query strings, env vars, third party APIs.\n\nimport { z } from "zod";\n\nconst CreateUser = z.object({\n  name: z.string().min(1),\n  email: z.string().email(),\n  age: z.number().int().min(18).optional(),\n});\n\ntype CreateUserInput = z.infer<typeof CreateUser>;\n\nconst result = CreateUser.safeParse(req.body);\nif (!result.success) return res.status(400).json(result.error.flatten());\n\nOne schema gives me both the validator and the type.`,
          ),
        }),
        node: directory({
          "event-loop-phases.txt": textFile(
            `NODE EVENT LOOP PHASES\n======================\n\n1. timers (setTimeout, setInterval)\n2. pending callbacks\n3. idle, prepare\n4. poll (I/O callbacks)\n5. check (setImmediate)\n6. close callbacks\n\nprocess.nextTick runs before promise microtasks, right after the current operation.\n\nNever block the loop with heavy CPU work. Use worker_threads or a queue.\n\nlibuv thread pool handles fs, dns lookups, crypto. Default size is 4 (UV_THREADPOOL_SIZE).`,
          ),
          "streams.txt": textFile(
            `STREAMS\n=======\n\nTypes: Readable, Writable, Duplex, Transform.\n\nUse streams for large files so memory stays flat.\n\nimport { createReadStream, createWriteStream } from "node:fs";\nimport { pipeline } from "node:stream/promises";\nimport { createGzip } from "node:zlib";\n\nawait pipeline(\n  createReadStream("big.log"),\n  createGzip(),\n  createWriteStream("big.log.gz")\n);\n\npipeline handles errors and cleanup. Prefer it over .pipe().\n\nWeb streams (ReadableStream) are also available in Node and match the browser API.`,
          ),
          "fs-and-path.txt": textFile(
            `FS AND PATH\n===========\n\nimport { readFile, writeFile, mkdir, readdir, stat } from "node:fs/promises";\nimport path from "node:path";\n\nconst file = path.join(process.cwd(), "data", "users.json");\nconst raw = await readFile(file, "utf8");\nconst data = JSON.parse(raw);\n\nawait mkdir(path.dirname(file), { recursive: true });\nawait writeFile(file, JSON.stringify(data, null, 2));\n\nAlways use the node: prefix for built-ins.\nUse path.join, never string concatenation with slashes.\nsync versions block the event loop. Fine for scripts, bad for servers.`,
          ),
          "env-and-config.txt": textFile(
            `ENVIRONMENT AND CONFIG\n======================\n\nNode 20+ can load env files natively:\nnode --env-file=.env server.js\n\nOr use dotenv:\nimport "dotenv/config";\n\nValidate env at startup with zod so the app fails fast.\n\nconst Env = z.object({\n  PORT: z.coerce.number().default(3000),\n  MONGODB_URI: z.string().url(),\n  JWT_SECRET: z.string().min(32),\n});\nexport const env = Env.parse(process.env);\n\nNever commit .env. Commit .env.example with fake values.`,
          ),
          "npm-scripts.txt": textFile(
            `NPM SCRIPTS AND PACKAGE.JSON\n============================\n\n{\n  "scripts": {\n    "dev": "node --watch src/server.js",\n    "build": "tsc",\n    "start": "node dist/server.js",\n    "lint": "eslint .",\n    "test": "vitest"\n  }\n}\n\nUseful commands:\nnpm ci                clean install from lockfile\nnpm outdated          see what can be updated\nnpm audit             check for known vulnerabilities\nnpx npm-check-updates interactive upgrades\nnpm ls <pkg>          why is this installed\n\ndependencies vs devDependencies: runtime vs build tooling.\nCommit the lockfile.`,
          ),
          "error-handling.txt": textFile(
            `PROCESS LEVEL ERROR HANDLING\n============================\n\nprocess.on("unhandledRejection", (reason) => {\n  console.error("Unhandled rejection:", reason);\n  process.exit(1);\n});\n\nprocess.on("uncaughtException", (err) => {\n  console.error("Uncaught exception:", err);\n  process.exit(1);\n});\n\nGraceful shutdown:\nprocess.on("SIGTERM", async () => {\n  server.close(async () => {\n    await mongoose.disconnect();\n    process.exit(0);\n  });\n});\n\nLet the process manager (pm2, systemd, Docker) restart the app after a crash.`,
          ),
          "testing.txt": textFile(
            `TESTING NOTES\n=============\n\nVitest for unit tests, Supertest for HTTP tests, Playwright for end to end.\n\nimport request from "supertest";\nimport { app } from "./app";\n\ntest("GET /health", async () => {\n  const res = await request(app).get("/health");\n  expect(res.status).toBe(200);\n});\n\nUse mongodb-memory-server for database tests.\nTest behaviour, not implementation.\nKeep tests fast and independent.`,
          ),
        }),
        express: directory({
          "setup.txt": textFile(
            `EXPRESS SETUP\n=============\n\nimport express from "express";\nimport cors from "cors";\nimport helmet from "helmet";\n\nconst app = express();\napp.use(helmet());\napp.use(cors({ origin: "https://example.com", credentials: true }));\napp.use(express.json({ limit: "1mb" }));\n\napp.get("/health", (req, res) => res.json({ ok: true }));\n\napp.listen(process.env.PORT || 3000);\n\nSeparate app.js (the Express app) from server.js (listen) so tests can import the app without opening a port.`,
          ),
          "middleware.txt": textFile(
            `MIDDLEWARE\n==========\n\nMiddleware is a function (req, res, next). It can read or change the request, end the response, or call next().\n\nfunction requestLogger(req, res, next) {\n  const start = Date.now();\n  res.on("finish", () => {\n    console.log(req.method, req.originalUrl, res.statusCode, Date.now() - start + "ms");\n  });\n  next();\n}\n\nOrder matters. Typical order:\n1. security (helmet, cors)\n2. logging\n3. body parsers\n4. routes\n5. 404 handler\n6. error handler (last)\n\nExpress 5 forwards rejected promises from async handlers to the error handler automatically. On Express 4 wrap handlers or use express-async-errors.`,
          ),
          "routing.txt": textFile(
            `ROUTING\n=======\n\nconst router = express.Router();\n\nrouter.get("/", listUsers);\nrouter.get("/:id", getUser);\nrouter.post("/", createUser);\nrouter.patch("/:id", updateUser);\nrouter.delete("/:id", deleteUser);\n\napp.use("/api/users", router);\n\nREST conventions:\nGET     read\nPOST    create\nPUT     replace\nPATCH   partial update\nDELETE  remove\n\nStatus codes: 200 OK, 201 Created, 204 No Content, 400 Bad Request, 401 Unauthorized, 403 Forbidden, 404 Not Found, 409 Conflict, 422 Unprocessable, 429 Too Many Requests, 500 Server Error.\n\nVersion the API: /api/v1/...`,
          ),
          "error-handling.txt": textFile(
            `ERROR HANDLING\n==============\n\nclass HttpError extends Error {\n  constructor(status, message) {\n    super(message);\n    this.status = status;\n  }\n}\n\napp.use((req, res) => {\n  res.status(404).json({ error: "Not found" });\n});\n\napp.use((err, req, res, next) => {\n  const status = err.status || 500;\n  if (status >= 500) console.error(err);\n  res.status(status).json({\n    error: status >= 500 ? "Internal server error" : err.message,\n  });\n});\n\nError handlers have four arguments. Express detects them by arity.\nNever leak stack traces to clients in production.`,
          ),
          "auth-jwt.txt": textFile(
            `AUTH WITH JWT\n=============\n\nFlow:\n1. User posts credentials to /auth/login\n2. Server checks password hash with bcrypt or argon2\n3. Server signs a short lived access token\n4. Token is sent in an httpOnly, secure, sameSite cookie\n5. Middleware verifies the token on protected routes\n\nimport jwt from "jsonwebtoken";\n\nconst token = jwt.sign({ sub: user.id, role: user.role }, process.env.JWT_SECRET, { expiresIn: "15m" });\n\nfunction requireAuth(req, res, next) {\n  try {\n    const token = req.cookies.token;\n    req.user = jwt.verify(token, process.env.JWT_SECRET);\n    next();\n  } catch {\n    res.status(401).json({ error: "Unauthorized" });\n  }\n}\n\nUse refresh tokens for long sessions. Never store tokens in localStorage if XSS is a concern.\nHash passwords with bcrypt (cost 12 or more) or argon2id. Never store plain text.`,
          ),
          "security.txt": textFile(
            `EXPRESS SECURITY CHECKLIST\n==========================\n\n- helmet for secure headers\n- cors with an explicit allow list\n- express-rate-limit on login and public endpoints\n- Validate all input (zod)\n- Sanitise Mongo operators: express-mongo-sanitize\n- Parameterised queries and ODM methods only\n- httpOnly, secure, sameSite cookies\n- HTTPS everywhere, trust proxy set correctly behind nginx\n- Limit body size\n- Keep dependencies updated (npm audit)\n- Do not log secrets or passwords\n- Use environment variables for secrets\n\nNoSQL injection example: { "email": { "$gt": "" } } as a login body. Validate that email is a string.`,
          ),
          "project-structure.txt": textFile(
            `PROJECT STRUCTURE\n=================\n\nsrc/\n  app.js            express app\n  server.js         starts the server\n  config/           env and db connection\n  routes/           route definitions\n  controllers/      request and response handling\n  services/         business logic\n  models/           mongoose schemas\n  middleware/       auth, validation, errors\n  utils/            helpers\ntests/\n\nControllers stay thin. Services hold the logic. Models only describe data.`,
          ),
        }),
        nextjs: directory({
          "app-router.txt": textFile(
            `APP ROUTER BASICS\n=================\n\napp/\n  layout.tsx         root layout\n  page.tsx           home route /\n  loading.tsx        loading UI (Suspense)\n  error.tsx          error boundary (client component)\n  not-found.tsx      404 UI\n  blog/\n    page.tsx         /blog\n    [slug]/page.tsx  /blog/my-post\n  (marketing)/       route group, not part of the URL\n  api/\n    users/route.ts   route handler\n\nLayouts persist between navigations and do not re-render.\nUse Link for client side navigation and useRouter for programmatic navigation.\nParallel routes use @folder. Intercepting routes use (.)folder.`,
          ),
          "server-components.txt": textFile(
            `SERVER COMPONENTS\n=================\n\nComponents in the app router are server components by default.\n\n- Can be async and fetch data directly\n- Can access the database and secrets\n- Ship no JavaScript to the client\n- Cannot use state, effects or browser APIs\n\nAdd "use client" at the top of a file for client components.\n\nAsync server component:\nexport default async function Page() {\n  const posts = await db.post.findMany();\n  return <PostList posts={posts} />;\n}\n\nPush "use client" as far down the tree as possible. Pass server components as children to client components to keep them on the server.\n\nProps passed from server to client must be serialisable.`,
          ),
          "data-fetching.txt": textFile(
            `DATA FETCHING\n=============\n\nFetch in server components with async and await.\n\nconst res = await fetch("https://api.example.com/posts", {\n  next: { revalidate: 60 },\n});\n\nDynamic data:\nfetch(url, { cache: "no-store" });\n\nParallel fetching:\nconst [user, posts] = await Promise.all([getUser(), getPosts()]);\n\nAvoid waterfalls: do not await one request before starting an independent one.\n\nGenerateStaticParams pre renders dynamic routes at build time.\nexport async function generateStaticParams() {\n  return posts.map((p) => ({ slug: p.slug }));\n}\n\nOn the client use SWR or TanStack Query for fetching and caching.`,
          ),
          "route-handlers.txt": textFile(
            `ROUTE HANDLERS\n==============\n\napp/api/users/route.ts\n\nimport { NextResponse } from "next/server";\n\nexport async function GET(request: Request) {\n  const { searchParams } = new URL(request.url);\n  const q = searchParams.get("q");\n  const users = await findUsers(q);\n  return NextResponse.json(users);\n}\n\nexport async function POST(request: Request) {\n  const body = await request.json();\n  const user = await createUser(body);\n  return NextResponse.json(user, { status: 201 });\n}\n\nSupported methods: GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS.\nUse them for webhooks and public APIs. For form mutations inside the app, prefer server actions.`,
          ),
          "server-actions.txt": textFile(
            `SERVER ACTIONS\n==============\n\nFunctions that run on the server, callable from forms or client components.\n\n"use server";\n\nimport { revalidatePath } from "next/cache";\n\nexport async function createPost(formData: FormData) {\n  const title = String(formData.get("title"));\n  await db.post.create({ data: { title } });\n  revalidatePath("/blog");\n}\n\nUsage:\n<form action={createPost}>\n  <input name="title" />\n  <button type="submit">Save</button>\n</form>\n\nAlways validate input and check authorisation inside the action. Treat every action like a public endpoint.\nuseActionState and useFormStatus help with pending and error UI.`,
          ),
          "caching.txt": textFile(
            `NEXT.JS CACHING\n===============\n\nLayers (names and defaults change between versions, always check the current docs):\n- Request memoisation: duplicate fetches in one render are deduped\n- Data cache: stores fetch results on the server\n- Full route cache: stores rendered HTML and RSC payload at build time\n- Router cache: client side cache of visited segments\n\nRevalidation:\n- Time based: next: { revalidate: 3600 }\n- On demand: revalidatePath("/blog") and revalidateTag("posts")\n\nOpt out of caching with cache: "no-store" or by reading cookies and headers (dynamic APIs).\n\nTODO: write a proper note once I have tested this on a real project.`,
          ),
          "middleware.txt": textFile(
            `NEXT.JS MIDDLEWARE\n==================\n\nRuns before a request is completed. Good for redirects, rewrites, auth checks and headers.\n\nimport { NextResponse } from "next/server";\nimport type { NextRequest } from "next/server";\n\nexport function middleware(request: NextRequest) {\n  const token = request.cookies.get("token");\n  if (!token) {\n    return NextResponse.redirect(new URL("/login", request.url));\n  }\n  return NextResponse.next();\n}\n\nexport const config = {\n  matcher: ["/dashboard/:path*"],\n};\n\nKeep it light. It runs on the edge runtime with limited APIs. Do the real authorisation check close to the data too.`,
          ),
          "metadata-and-seo.txt": textFile(
            `METADATA AND SEO\n================\n\nexport const metadata = {\n  title: "My Site",\n  description: "Notes and projects",\n  openGraph: { images: ["/og.png"] },\n};\n\nDynamic metadata:\nexport async function generateMetadata({ params }) {\n  const post = await getPost(params.slug);\n  return { title: post.title };\n}\n\nAlso: sitemap.ts, robots.ts, next/image for responsive images, next/font to avoid layout shift.`,
          ),
          "deployment.txt": textFile(
            `DEPLOYING NEXT.JS\n=================\n\nOptions:\n- Vercel: easiest, zero config\n- Docker: output: "standalone" in next.config for a small image\n- Node server: next build then next start behind nginx\n\nChecklist:\n- Set all environment variables\n- NEXT_PUBLIC_ prefix exposes a variable to the browser. Never put secrets there.\n- Check image domains in next.config\n- Set up health checks and logging`,
          ),
        }),
        react: directory({
          "hooks.txt": textFile(
            `REACT HOOKS\n===========\n\nuseState        local state\nuseReducer      complex state transitions\nuseEffect       side effects after render\nuseRef          mutable value or DOM node, no re-render\nuseMemo         cache a computed value\nuseCallback     cache a function reference\nuseContext      read context\nuseId           stable unique ids\nuseTransition   mark updates as non urgent\nuseDeferredValue defer a value\n\nRules:\n- Only call hooks at the top level\n- Only call hooks from components or custom hooks\n\nconst [count, setCount] = useState(0);\nsetCount((c) => c + 1); // use the updater form when depending on previous state`,
          ),
          "useeffect-notes.txt": textFile(
            `USEEFFECT NOTES\n===============\n\nuseEffect(() => {\n  const controller = new AbortController();\n  fetch(url, { signal: controller.signal })\n    .then((r) => r.json())\n    .then(setData)\n    .catch(() => {});\n  return () => controller.abort();\n}, [url]);\n\nThe dependency array lists every reactive value used inside the effect.\nThe cleanup function runs before the next effect and on unmount.\nStrict mode runs effects twice in development to expose missing cleanup.\n\nYou might not need an effect:\n- Derived values: compute during render\n- Responding to events: use the event handler\n- Resetting state on prop change: use a key`,
          ),
          "custom-hooks.txt": textFile(
            `CUSTOM HOOKS\n============\n\nfunction useDebounce(value, delay = 300) {\n  const [debounced, setDebounced] = useState(value);\n  useEffect(() => {\n    const id = setTimeout(() => setDebounced(value), delay);\n    return () => clearTimeout(id);\n  }, [value, delay]);\n  return debounced;\n}\n\nfunction useLocalStorage(key, initial) {\n  const [value, setValue] = useState(() => {\n    const saved = localStorage.getItem(key);\n    return saved ? JSON.parse(saved) : initial;\n  });\n  useEffect(() => {\n    localStorage.setItem(key, JSON.stringify(value));\n  }, [key, value]);\n  return [value, setValue];\n}\n\nCustom hooks must start with use.\nIn SSR, guard browser APIs like localStorage and window.`,
          ),
          "state-management.txt": textFile(
            `STATE MANAGEMENT\n================\n\nOrder of preference:\n1. Local state with useState\n2. Lift state up to a common parent\n3. Context for low frequency global data (theme, user)\n4. Zustand or Redux Toolkit for shared client state\n5. TanStack Query or SWR for server state\n\nServer state is not client state. Do not copy fetched data into useState.\n\nURL state (search params) is great for filters and pagination because it is shareable.\n\nContext re-renders every consumer when its value changes. Split contexts or memoise the value.`,
          ),
          "performance.txt": textFile(
            `REACT PERFORMANCE\n=================\n\n- Measure first with the React DevTools profiler\n- Keep state close to where it is used\n- React.memo only for expensive pure components\n- useMemo and useCallback when passing to memoised children or heavy calculations\n- Virtualise long lists (TanStack Virtual, react-window)\n- Code split with lazy and Suspense\n- Use stable keys, never array index for dynamic lists\n- Avoid creating new objects in props needlessly\n- Images: correct size, lazy loading, modern formats\n\nThe React Compiler can handle a lot of memoisation automatically in newer setups.`,
          ),
          "patterns.txt": textFile(
            `COMPONENT PATTERNS\n==================\n\n- Composition with children\n- Compound components (Tabs, Tab, TabPanel)\n- Controlled vs uncontrolled inputs\n- Render props (less common now)\n- Container and presentational split\n- Error boundaries for graceful failures\n- Portals for modals and tooltips\n\nControlled input:\nconst [text, setText] = useState("");\n<input value={text} onChange={(e) => setText(e.target.value)} />\n\nAlways give lists a key:\n{items.map((i) => <Item key={i.id} {...i} />)}`,
          ),
          "forms.txt": textFile(
            `FORMS\n=====\n\nReact Hook Form plus zod resolver is my default.\n\nconst { register, handleSubmit, formState: { errors } } = useForm({\n  resolver: zodResolver(schema),\n});\n\n<form onSubmit={handleSubmit(onSubmit)}>\n  <input {...register("email")} />\n  {errors.email && <p>{errors.email.message}</p>}\n</form>\n\nAccessibility: every input needs a label. Associate errors with aria-describedby.\nValidate on the server as well. Client validation is only for convenience.`,
          ),
        }),
        astro: directory({
          "overview.txt": textFile(
            `ASTRO OVERVIEW\n==============\n\nContent focused framework. Ships zero JavaScript by default.\n\nsrc/\n  pages/         file based routing (.astro, .md, .mdx)\n  layouts/       shared page shells\n  components/    .astro and framework components\n  content/       content collections\n  styles/\npublic/          static assets\nastro.config.mjs\n\nAn .astro file has a frontmatter script fence and a template:\n---\nconst posts = await getCollection("blog");\n---\n<ul>{posts.map((p) => <li>{p.data.title}</li>)}</ul>\n\nBring your own UI: React, Vue, Svelte, Solid can all be used.`,
          ),
          "islands.txt": textFile(
            `ISLANDS ARCHITECTURE\n====================\n\nInteractive components are islands of JavaScript in a sea of static HTML.\n\nClient directives:\nclient:load      hydrate immediately\nclient:idle      hydrate when the browser is idle\nclient:visible   hydrate when scrolled into view\nclient:media     hydrate on a media query\nclient:only      skip server render, client only\n\n<Counter client:visible />\n\nWithout a client directive a framework component renders to static HTML only.\n\nShare state between islands with nanostores.`,
          ),
          "content-collections.txt": textFile(
            `CONTENT COLLECTIONS\n===================\n\nsrc/content.config.ts\n\nimport { defineCollection, z } from "astro:content";\nimport { glob } from "astro/loaders";\n\nconst blog = defineCollection({\n  loader: glob({ pattern: "**/*.md", base: "./src/content/blog" }),\n  schema: z.object({\n    title: z.string(),\n    date: z.coerce.date(),\n    tags: z.array(z.string()).default([]),\n  }),\n});\n\nexport const collections = { blog };\n\nQuery:\nconst posts = await getCollection("blog");\n\nFrontmatter is type checked against the schema. Build fails on bad content, which is what I want.`,
          ),
          "ssr-and-adapters.txt": textFile(
            `ASTRO SSR AND ADAPTERS\n======================\n\nDefault output is static. Enable server rendering with an adapter.\n\nimport node from "@astrojs/node";\n\nexport default defineConfig({\n  output: "server",\n  adapter: node({ mode: "standalone" }),\n});\n\nAdapters: Node, Vercel, Netlify, Cloudflare.\n\nPer page opt out of prerendering in server mode:\nexport const prerender = false;\n\nAstro.cookies, Astro.request and Astro.redirect are available in server pages.\n\nAPI endpoints live in src/pages/api/*.ts and export GET, POST and so on.\nActions give typed server functions for forms.`,
          ),
          "view-transitions.txt": textFile(
            `VIEW TRANSITIONS\n================\n\nAdd the client router component to the layout head for smooth page transitions.\n\nUse transition:name and transition:persist on elements that should animate or keep state between pages.\n\nScripts may need to listen to astro:page-load instead of DOMContentLoaded.`,
          ),
        }),
        ssr: directory({
          "rendering-strategies.txt": textFile(
            `RENDERING STRATEGIES\n====================\n\nCSR  client side rendering\n     Browser downloads JS and builds the page. Slow first paint, poor default SEO.\n\nSSR  server side rendering\n     HTML generated per request. Good SEO and fresh data. Costs server time.\n\nSSG  static site generation\n     HTML generated at build time. Fastest, cheapest, great for content.\n\nISR  incremental static regeneration\n     Static pages that revalidate in the background.\n\nStreaming SSR\n     Server sends HTML in chunks as data resolves.\n\nHybrid is normal: static marketing pages, SSR dashboards, client side widgets.\n\nChoose per route, not per project.`,
          ),
          "hydration.txt": textFile(
            `HYDRATION\n=========\n\nHydration attaches event listeners and state to server rendered HTML.\n\nHydration mismatch happens when server HTML differs from the first client render.\n\nCommon causes:\n- Date.now() or Math.random() in render\n- Reading window or localStorage during render\n- Locale or timezone differences\n- Invalid HTML nesting (div inside p)\n- Browser extensions modifying the DOM\n\nFixes:\n- Move browser only code into useEffect\n- Use a mounted flag for client only UI\n- suppressHydrationWarning for unavoidable text like timestamps\n\nPartial hydration (Astro islands) and server components both reduce the JavaScript that needs to hydrate.`,
          ),
          "streaming-and-suspense.txt": textFile(
            `STREAMING AND SUSPENSE\n======================\n\nWrap slow parts in Suspense so the rest of the page can be sent immediately.\n\nexport default function Page() {\n  return (\n    <>\n      <Header />\n      <Suspense fallback={<Skeleton />}>\n        <SlowRecommendations />\n      </Suspense>\n    </>\n  );\n}\n\nThe shell arrives first, the slow part streams in later.\nGreat for time to first byte and perceived speed.\nloading.tsx in Next.js is Suspense around the route segment.`,
          ),
          "ssr-checklist.txt": textFile(
            `SSR CHECKLIST\n=============\n\n- No window or document access during server render\n- Cache expensive data\n- Set Cache-Control headers on public pages\n- Handle errors with a friendly fallback\n- Keep components deterministic\n- Compress responses (gzip or brotli)\n- Monitor time to first byte\n- Put a CDN in front for static assets`,
          ),
        }),
        mongodb: directory({
          "crud.txt": textFile(
            `MONGODB CRUD\n============\n\ndb.users.insertOne({ name: "Tabrez", role: "dev" });\ndb.users.insertMany([{ name: "A" }, { name: "B" }]);\n\ndb.users.find({ role: "dev" });\ndb.users.find({ age: { $gte: 18 } }, { name: 1, _id: 0 });\ndb.users.findOne({ _id: ObjectId("...") });\n\ndb.users.updateOne({ name: "A" }, { $set: { role: "admin" } });\ndb.users.updateMany({}, { $inc: { logins: 1 } });\ndb.users.replaceOne({ name: "A" }, { name: "A", role: "user" });\n\ndb.users.deleteOne({ name: "A" });\ndb.users.deleteMany({ active: false });\n\nOperators: $eq $ne $gt $gte $lt $lte $in $nin $and $or $not $exists $regex\nUpdate operators: $set $unset $inc $push $pull $addToSet $rename`,
          ),
          "aggregation.txt": textFile(
            `AGGREGATION PIPELINE\n====================\n\nStages run in order. Each stage feeds the next.\n\ndb.orders.aggregate([\n  { $match: { status: "paid" } },\n  { $group: { _id: "$customerId", total: { $sum: "$amount" }, orders: { $sum: 1 } } },\n  { $sort: { total: -1 } },\n  { $limit: 10 },\n  { $lookup: { from: "users", localField: "_id", foreignField: "_id", as: "user" } },\n  { $unwind: "$user" },\n  { $project: { _id: 0, name: "$user.name", total: 1, orders: 1 } }\n]);\n\nKey stages: $match $group $project $sort $limit $skip $lookup $unwind $addFields $facet $count\n\nPut $match and $limit as early as possible so indexes can be used and less data flows through.`,
          ),
          "indexes.txt": textFile(
            `INDEXES\n=======\n\ndb.users.createIndex({ email: 1 }, { unique: true });\ndb.posts.createIndex({ authorId: 1, createdAt: -1 });\ndb.posts.createIndex({ title: "text", body: "text" });\ndb.sessions.createIndex({ createdAt: 1 }, { expireAfterSeconds: 3600 });\n\nCompound index rule (ESR): Equality fields first, then Sort fields, then Range fields.\n\nCheck usage:\ndb.posts.find({ authorId: id }).explain("executionStats");\n\nLook for IXSCAN (good) and COLLSCAN (bad). Compare totalDocsExamined to nReturned.\n\nEvery index slows writes and uses memory. Only index what you query.`,
          ),
          "schema-design.txt": textFile(
            `SCHEMA DESIGN\n=============\n\nEmbed when:\n- Data is read together\n- The child belongs to one parent\n- The array stays small\n\nReference when:\n- Data is shared between documents\n- The child array could grow without limit\n- The child is updated independently\n\nDocument limit is 16 MB. Avoid unbounded arrays.\n\nExample:\nuser { _id, name, address: { city, country } }       embedded\npost { _id, authorId, title, body }                   referenced\ncomment { _id, postId, authorId, text }               referenced\n\nDesign for your queries, not for normalisation.\nDenormalise a little for read speed (store authorName on posts) and accept the update cost.`,
          ),
          "mongoose.txt": textFile(
            `MONGOOSE\n========\n\nimport mongoose from "mongoose";\n\nconst userSchema = new mongoose.Schema(\n  {\n    name: { type: String, required: true, trim: true },\n    email: { type: String, required: true, unique: true, lowercase: true },\n    role: { type: String, enum: ["user", "admin"], default: "user" },\n  },\n  { timestamps: true }\n);\n\nexport const User = mongoose.models.User || mongoose.model("User", userSchema);\n\nConnect once:\nawait mongoose.connect(process.env.MONGODB_URI);\n\nUseful methods: find, findById, findOne, create, findByIdAndUpdate (use { new: true }), deleteOne, populate, lean.\n\nlean() returns plain objects and is faster for read only queries.\n\nIn Next.js dev mode, cache the connection on globalThis to avoid opening a new connection on every hot reload. The models.User check above avoids model overwrite errors.`,
          ),
          "atlas-and-backup.txt": textFile(
            `ATLAS AND BACKUPS\n=================\n\n- Create a database user with least privilege\n- Allow only known IP addresses\n- Use the SRV connection string (mongodb+srv://)\n- Turn on backups and alerts\n\nLocal tools:\nmongodump --uri="$MONGODB_URI" --out=./backup\nmongorestore --uri="$MONGODB_URI" ./backup\nmongoexport / mongoimport for JSON and CSV\n\nMongoDB Compass for browsing data and testing queries.\nTransactions need a replica set (Atlas always is one).`,
          ),
          "transactions.txt": textFile(
            `TRANSACTIONS\n============\n\nSingle document operations are atomic already. Use transactions only for multi document changes.\n\nconst session = await mongoose.startSession();\ntry {\n  await session.withTransaction(async () => {\n    await Account.updateOne({ _id: from }, { $inc: { balance: -amt } }, { session });\n    await Account.updateOne({ _id: to }, { $inc: { balance: amt } }, { session });\n  });\n} finally {\n  await session.endSession();\n}\n\nGood schema design reduces the need for transactions.`,
          ),
