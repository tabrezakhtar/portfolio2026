---
const roles = [
	'JavaScript developer',
	'JavaScript engineer',
	'React developer',
	'React engineer',
	'Front-end developer',
	'Front-end engineer',
	'Frontend developer',
	'Frontend engineer',
	'Full-stack developer',
	'Full-stack engineer',
	'Fullstack engineer',
	'Fullstack engineer',
	'Node.js developer',
	'Node.js engineer',
];
---

<aside class="side-menu" aria-label="Profile and site navigation">
	<header class="side-titlebar">
		<span class="side-title-mark" aria-hidden="true">❯</span>
		<span class="side-title">tabrez@localhost <span>~/profile</span></span>
		<span class="side-title-meta">sidebar</span>
		<span class="side-window-indicator" aria-hidden="true"></span>
	</header>
	<div class="side-menu-content">
		<div class="profile">
			<a class="avatar-link" href="#home" aria-label="Tabrez Akhtar home">
				<img
					src="https://res.cloudinary.com/dx8d5hlk1/image/upload/f_auto/v1775227131/profile_vo7jkl.png"
					alt="Tabrez Akhtar profile picture"
				/>
			</a>
			<h2><a href="#home">Tabrez Akhtar</a></h2>
			<div class="social-links" aria-label="Social links">
				<a href="mailto:hello@melodyapps.co.uk" aria-label="Email Tabrez Akhtar" title="Email">
					<i class="bx bx-envelope" aria-hidden="true"></i>
				</a>
				<a href="https://www.linkedin.com/in/tabrezakhtar" aria-label="LinkedIn profile of Tabrez Akhtar" title="LinkedIn" target="_blank" rel="noopener noreferrer">
					<i class="bx bxl-linkedin" aria-hidden="true"></i>
				</a>
				<a href="https://github.com/tabrezakhtar" aria-label="GitHub profile of Tabrez Akhtar" title="GitHub" target="_blank" rel="noopener noreferrer">
					<i class="bx bxl-github" aria-hidden="true"></i>
				</a>
				<a href="https://www.credly.com/badges/0ed0f330-58be-4cbd-a341-4ee7150699f6/public_url" aria-label="AWS Certified Developer - Associate certification" title="AWS certification" target="_blank" rel="noopener noreferrer">
					<i class="bx bxl-aws" aria-hidden="true"></i>
				</a>
			</div>
		</div>

		<details class="role-details">
			<summary>Specialties</summary>
			<ul>
				{roles.map((role) => <li>{role}</li>)}
			</ul>
		</details>

		<nav class="side-nav" aria-label="Main navigation">
			<p class="side-prompt"><span>tabrez@localhost</span>:~$ ls ./navigation</p>
			<a href="#home"><i class="bx bx-home" aria-hidden="true"></i><span>Home</span></a>
			<a href="#about"><i class="bx bx-user" aria-hidden="true"></i><span>About</span></a>
			<a href="#work"><i class="bx bx-edit" aria-hidden="true"></i><span>Blog</span></a>
			<a href="#work"><i class="bx bx-book-content" aria-hidden="true"></i><span>Projects</span></a>
			<a href="#capabilities"><i class="bx bx-server" aria-hidden="true"></i><span>Services</span></a>
			<a href="#contact"><i class="bx bx-envelope" aria-hidden="true"></i><span>Contact</span></a>
		</nav>
	</div>
	<footer class="side-statusbar">
		<span>[profile]</span>
		<span>0:navigation*</span>
		<span>UTF-8</span>
	</footer>
</aside>

<script>
	const sideNav = document.querySelector('.side-nav');
	if (sideNav) {
		const links = Array.from(sideNav.querySelectorAll('a[href^="#"]'));
		let clickedHash = '';

		const selectLink = (link) => {
			links.forEach((item) => {
				const selected = item === link;
				item.classList.toggle('is-selected', selected);
				if (selected) item.setAttribute('aria-current', 'page');
				else item.removeAttribute('aria-current');
			});
		};

		const syncToHash = () => {
			if (window.location.hash === clickedHash) return;
			selectLink(links.find((link) => link.hash === window.location.hash));
		};

		links.forEach((link) => {
			link.addEventListener('click', () => {
				clickedHash = link.hash;
				selectLink(link);
			});
		});
		window.addEventListener('hashchange', syncToHash);
		window.addEventListener('popstate', syncToHash);
		syncToHash();
	}
</script>

<style>
	.side-menu {
		position: fixed;
		z-index: 5;
		inset: var(--page-gutter, 10px) auto var(--page-gutter, 10px) var(--page-gutter, 10px);
		width: 250px;
		border: 1px solid #59406f;
		background: #100e1d;
		box-shadow: 0 0 0 1px #ff4fd80c, 12px 0 36px #03020b70, 0 0 32px #8c38ff12;
		color: #f6f1ff;
		display: flex;
		flex-direction: column;
	}

	.side-titlebar {
		min-height: 37px;
		padding: 0 11px;
		border-bottom: 1px solid #38294b;
		background: #121511;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto auto;
		align-items: center;
	}

	.side-title-mark {
		margin-right: 8px;
		color: #b9ff66;
		font-family: 'Space Mono', monospace;
		font-size: 11px;
		font-weight: 700;
	}

	.side-title,
	.side-title-meta,
	.side-statusbar,
	.side-prompt {
		font-family: 'Space Mono', monospace;
	}

	.side-title {
		color: #e6d9f5;
		font-size: 9px;
		white-space: nowrap;
	}

	.side-title > span {
		color: #b99aff;
	}

	.side-title-meta {
		color: #8d7eaa;
		font-size: 8px;
	}

	.side-window-indicator {
		width: 9px;
		height: 9px;
		margin-left: 9px;
		background: #ff5b64;
		box-shadow: 0 0 8px #ff5b6466;
	}

	.side-menu-content {
		min-height: 0;
		padding: 26px 18px 20px;
		overflow-y: auto;
		flex: 1;
	}

	.side-statusbar {
		min-height: 27px;
		padding: 0 9px;
		border-top: 1px solid #453156;
		background: #1a1529;
		color: #a99dbf;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		font-size: 8px;
	}

	.side-statusbar span:first-child {
		color: #b9ff66;
	}

	.profile {
		text-align: center;
	}

	.avatar-link {
		width: 96px;
		aspect-ratio: 1;
		margin: 0 auto 16px;
		padding: 4px;
		border: 2px solid #008080;
		border-radius: 50%;
		display: grid;
		place-items: center;
	}

	.avatar-link img {
		width: 100%;
		height: 100%;
		display: block;
		border-radius: 50%;
		object-fit: cover;
		object-position: center;
	}

	.profile h2 {
		margin: 0 0 15px;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 19px;
		font-weight: 600;
	}

	.profile h2 a {
		text-decoration: none;
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 9px;
	}

	.social-links a {
		width: 36px;
		aspect-ratio: 1;
		border: 1px solid #453156;
		background: #171326;
		color: #40f4ff;
		display: grid;
		place-items: center;
		font-size: 18px;
		text-decoration: none;
		transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
	}

	.social-links a:hover {
		border-color: #40f4ff;
		background: #40f4ff;
		color: #0b0b1c;
	}

	.role-details {
		margin-top: 24px;
		padding: 12px 0;
		border-top: 1px solid #392950;
		border-bottom: 1px solid #392950;
		color: #a89bbd;
		font-family: 'Space Mono', monospace;
		font-size: 10px;
	}

	.role-details summary {
		color: #b9ff66;
		cursor: pointer;
		list-style-position: inside;
		text-transform: uppercase;
	}

	.role-details ul {
		margin: 12px 0 0;
		padding: 0 0 0 17px;
		line-height: 1.9;
	}

	.side-nav {
		margin-top: 22px;
		display: grid;
		gap: 5px;
	}

	.side-prompt {
		margin: 0 0 9px;
		color: #c1b6d2;
		font-size: 9px;
		white-space: nowrap;
	}

	.side-prompt span {
		color: #40f4ff;
	}

	.side-nav a {
		min-height: 42px;
		padding: 0 12px;
		border-left: 2px solid transparent;
		color: #c1b6d2;
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: 'Space Mono', monospace;
		font-size: 11px;
		text-decoration: none;
		transition: color 160ms ease, background 160ms ease, border-color 160ms ease;
	}

	.side-nav a:hover,
	.side-nav a:focus-visible,
	.side-nav a.is-selected {
		border-left-color: #ff4fd8;
		background: #ff4fd814;
		color: #f6f1ff;
	}

	.side-nav a.is-selected i {
		color: #ff4fd8;
	}

	.side-nav i {
		color: #40f4ff;
		font-size: 18px;
	}

	@media (max-width: 900px) {
		.side-menu {
			position: relative;
			inset: auto;
			width: auto;
			margin: var(--page-gutter, 10px) var(--page-gutter, 10px) 0;
			min-height: 0;
			box-shadow: 0 8px 26px #03020b70;
		}

		.side-menu-content {
			padding: 15px 5%;
			overflow: visible;
			display: grid;
			grid-template-columns: auto 1fr;
			align-items: center;
			gap: 14px 22px;
		}

		.profile {
			display: grid;
			grid-template-columns: 48px auto;
			align-items: center;
			gap: 0 11px;
			text-align: left;
		}

		.avatar-link {
			width: 48px;
			margin: 0;
			grid-row: span 2;
		}

		.profile h2 {
			margin: 0 0 4px;
			font-size: 14px;
		}

		.social-links {
			justify-content: flex-start;
			gap: 7px;
		}

		.social-links a {
			width: 27px;
			font-size: 15px;
		}

		.role-details {
			grid-column: 1 / -1;
			margin: 0;
			padding: 8px 0;
		}

		.role-details ul {
			columns: 2;
		}

		.side-nav {
			margin: 0;
			display: flex;
			justify-content: flex-end;
			gap: 2px;
			overflow-x: auto;
		}

		.side-nav a {
			min-height: 38px;
			padding: 0 8px;
			border-left: 0;
			border-bottom: 2px solid transparent;
			gap: 6px;
			white-space: nowrap;
			font-size: 9px;
		}

		.side-nav a:hover,
		.side-nav a:focus-visible,
		.side-nav a.is-selected {
			border-bottom-color: #ff4fd8;
			border-left-color: transparent;
		}
	}

	@media (max-width: 560px) {
		.side-menu-content {
			grid-template-columns: 1fr;
			gap: 10px;
			padding: 12px 22px;
		}

		.side-title-meta {
			display: none;
		}

		.side-nav {
			justify-content: flex-start;
			margin: 0 -8px;
		}
	}
</style>
