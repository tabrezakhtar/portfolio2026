<script>
	const homeLinks = document.querySelectorAll<HTMLAnchorElement>('.avatar-link, .side-nav a[href="#home"]');
	homeLinks.forEach((homeLink) => {
		homeLink.addEventListener('click', () => {
		window.setTimeout(() => {
			if (window.location.hash === '#home') {
				window.history.replaceState(window.history.state, '', `${window.location.pathname}${window.location.search}`);
			}
		}, 0);
		});
	});

	const menu = document.getElementById('side-menu');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const backdrop = document.querySelector('[data-menu-backdrop]');
	const setMenuOpen = (open: boolean) => {
		document.body.classList.toggle('menu-open', open);
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
	};
	toggle?.addEventListener('click', () => setMenuOpen(!document.body.classList.contains('menu-open')));
	backdrop?.addEventListener('click', () => setMenuOpen(false));
	menu?.addEventListener('click', (event) => {
		if ((event.target as Element).closest('a')) setMenuOpen(false);
	});
	window.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && document.body.classList.contains('menu-open')) {
			setMenuOpen(false);
			toggle?.focus();
		}
	});
	window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
		if (event.matches) setMenuOpen(false);
	});

	const sideNav = document.querySelector('.side-nav');
	if (sideNav) {
		const links = Array.from(sideNav.querySelectorAll('a[href^="#"]')) as any[];
		let clickedHash = '';

		const selectLink = (link: any) => {
			links.forEach((item) => {
				const selected = item === link;
				item.classList.toggle('is-selected', selected);
				if (selected) item.setAttribute('aria-current', 'page');
				else item.removeAttribute('aria-current');
			});
		};

		const syncToHash = () => {
			if (window.location.hash === clickedHash) return;
			selectLink(links.find((link) => link.hash === window.location.hash));
		};

		links.forEach((link) => {
			link.addEventListener('click', () => {
				clickedHash = link.hash;
				selectLink(link);
			});
		});
		window.addEventListener('hashchange', syncToHash);
		window.addEventListener('popstate', syncToHash);
		syncToHash();
	}
</script>

