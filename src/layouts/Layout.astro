---
import 'lite-youtube-embed/src/lite-yt-embed.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Tabrez - Full-Stack Software Engineer & Digital Craftsman',
	description = 'Tabrez is a Full-Stack Software Engineer creating thoughtful digital products, useful interfaces, and modern web experiences.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0b1c" />
		<link rel="icon" href="/terminal.png" sizes="any" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
				<link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Geist+Pixel&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>

	<body>
		<slot />
		<script is:inline>
			(function(projectName) {
				if (!projectName || typeof projectName !== 'string') {
					console.error('Anon Hit Counter: Project name is required');
					return;
				}

				const API_URL = 'https://anon-hit-counter.vercel.app/log';

				function sendHit() {
					const mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					fetch(API_URL, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							project: projectName,
							page: window.location.href,
							mode: mode,
						}),
						keepalive: true,
					}).catch(function(error) {
						console.debug('Analytics request failed:', error);
					});
				}

				document.addEventListener('DOMContentLoaded', sendHit);
			})('portfolio2026');
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<style is:global>
	:root {
		scrollbar-color: #59406f #100e1d;
		scrollbar-width: thin;
	}

	::-webkit-scrollbar {
		width: 10px;
		height: 10px;
	}

	::-webkit-scrollbar-track {
		border: 1px solid #38294b;
		background: #100e1d;
	}

	::-webkit-scrollbar-thumb {
		border: 2px solid #100e1d;
		background: #59406f;
	}

	::-webkit-scrollbar-thumb:hover {
		background: #40f4ff;
		box-shadow: 0 0 8px #40f4ff80;
	}

	::-webkit-scrollbar-corner {
		background: #100e1d;
	}

	lite-youtube {
		width: 560px;
		height: 420px;
		max-width: 560px;
	}

	lite-youtube::after {
		padding-bottom: 0;
	}

	@media (max-width: 560px) {
		lite-youtube {
			width: 100%;
			height: auto;
			aspect-ratio: 4 / 3;
		}
	}
</style>

<script>
	import hljs from 'highlight.js';
	import 'highlight.js/styles/github-dark.css';
	import 'lite-youtube-embed';

	document.addEventListener('DOMContentLoaded', () => {
		hljs.highlightAll();
	});

	// Reusable "decrypt" scramble animation: add data-decrypt to any element
	// and it will randomize its text on hover/tap, then settle back to normal.
	const DECRYPT_UPPER_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
	const DECRYPT_LOWER_CHARS = 'abcdefghijklmnopqrstuvwxyz';
	const DECRYPT_DIGITS = '0123456789';
	const splitCharacters = (value: string) => {
		const segmenter = Intl.Segmenter
			? new Intl.Segmenter(undefined, { granularity: 'grapheme' })
			: null;
		return segmenter
			? Array.from(segmenter.segment(value), ({ segment }) => segment)
			: Array.from(value);
	};
	const decryptTimers = new WeakMap();
	const decryptTextNodes = new WeakMap<HTMLElement, Array<{ node: Text; original: string }>>();

	const runDecrypt = (el: HTMLElement) => {
		let textNodes = decryptTextNodes.get(el);
		if (!textNodes) {
			const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
			textNodes = [];
			while (walker.nextNode()) {
				const node = walker.currentNode as Text;
				textNodes.push({ node, original: node.textContent ?? '' });
			}
			decryptTextNodes.set(el, textNodes);
		}

		const previousTimer = decryptTimers.get(el);
		if (previousTimer) clearInterval(previousTimer);
		textNodes.forEach(({ node, original }) => {
			node.textContent = original;
		});

		const duration = 400 + Math.random() * 300;
		const stepTime = 28 + Math.random() * 14;
		const totalSteps = Math.round(duration / stepTime);
		const animationText = textNodes.map(({ node, original }) => {
			const chars = splitCharacters(original);
			return {
				node,
				chars,
				revealAt: chars.map(() => 0.05 + Math.random() * 0.9),
			};
		});
		let step = 0;

		const interval = setInterval(() => {
			step += 1;
			const progress = step / totalSteps;
			animationText.forEach(({ node, chars, revealAt }) => {
				node.textContent = chars
					.map((char, index) => {
						if (progress >= revealAt[index] || !/^[a-z0-9]$/i.test(char)) return char;
						const pool = /[0-9]/.test(char)
							? DECRYPT_DIGITS
							: char === char.toLowerCase()
								? DECRYPT_LOWER_CHARS
								: DECRYPT_UPPER_CHARS;
						const alternatives = pool.replace(char, '');
						return alternatives[Math.floor(Math.random() * alternatives.length)];
					})
					.join('');
			});

			if (step >= totalSteps) {
				clearInterval(interval);
				decryptTimers.delete(el);
				textNodes.forEach(({ node, original }) => {
					node.textContent = original;
				});
			}
		}, stepTime);

		decryptTimers.set(el, interval);
	};

	document.addEventListener('mouseenter', (event) => {
		const el = event.target instanceof Element
			? event.target.closest<HTMLElement>('[data-decrypt]')
			: null;
		if (el) runDecrypt(el);
	}, true);

	document.addEventListener('touchstart', (event) => {
		const el = event.target instanceof Element
			? event.target.closest<HTMLElement>('[data-decrypt]')
			: null;
		if (el) runDecrypt(el);
	}, { capture: true, passive: true });
</script>
