---
import Layout from './Layout.astro';

interface Props {
	frontmatter: {
		title?: string;
		pubDate?: string | Date;
		description?: string;
		author?: string;
		tags?: string[];
	};
}

interface PostMetadata {
	title?: string;
	pubDate?: string | Date;
}

const { frontmatter } = Astro.props;
const postDate = frontmatter.pubDate ? new Date(frontmatter.pubDate) : null;
const dateLabel = postDate && !Number.isNaN(postDate.getTime())
	? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(postDate)
	: '';
const posts = Object.entries(
	import.meta.glob<{ frontmatter: PostMetadata }>('../pages/posts/*.md', { eager: true }),
)
	.map(([path, post]) => {
		const slug = path.split('/').pop()?.replace(/\.md$/, '') ?? '';
		const date = new Date(post.frontmatter.pubDate ?? '');
		return { slug, title: post.frontmatter.title ?? slug, date };
	})
	.filter((post) => post.slug && !Number.isNaN(post.date.getTime()))
	.sort((first, second) => second.date.getTime() - first.date.getTime());
const currentSlug = Astro.url.pathname.split('/').filter(Boolean).at(-1);
const currentIndex = posts.findIndex((post) => post.slug === currentSlug);
const previousPost = currentIndex >= 0 ? posts[currentIndex + 1] : undefined;
const nextPost = currentIndex > 0 ? posts[currentIndex - 1] : undefined;
---

<Layout title={frontmatter.title} description={frontmatter.description}>
	<main class="post-shell">
		<a class="post-back" href="/#blog"><span aria-hidden="true">←</span> Back to blog</a>
		<article class="post-window">
			<header class="post-header">
				<p class="post-kicker"><span>tabrez@localhost</span>:~/blog</p>
				<h1>{frontmatter.title}</h1>
				{frontmatter.description && <p class="post-description">{frontmatter.description}</p>}
				<div class="post-meta">
					{dateLabel && postDate && <time datetime={postDate.toISOString()}>{dateLabel}</time>}
					{frontmatter.author && <span>By {frontmatter.author}</span>}
				</div>
				{frontmatter.tags && frontmatter.tags.length > 0 && (
					<ul class="post-tags" aria-label="Post tags">
						{frontmatter.tags.map((tag) => <li>{tag}</li>)}
					</ul>
				)}
			</header>
			<div class="post-content"><slot /></div>
			<nav class="article-navigation" aria-label="Article navigation">
				{previousPost ? (
					<a class="article-nav-link previous" href={`/posts/${previousPost.slug}`}>
						<span class="article-nav-label"><span aria-hidden="true">←</span> Previous article</span>
						<span class="article-nav-title">{previousPost.title}</span>
					</a>
				) : <span class="article-nav-empty" aria-hidden="true"></span>}
				{nextPost && (
					<a class="article-nav-link next" href={`/posts/${nextPost.slug}`}>
						<span class="article-nav-label">Next article <span aria-hidden="true">→</span></span>
						<span class="article-nav-title">{nextPost.title}</span>
					</a>
				)}
			</nav>
		</article>
	</main>
</Layout>

<style is:global>
	html, body { min-height: 100%; }
	body {
		background-color: #0b0b1c;
		background-image:
			repeating-linear-gradient(0deg, transparent 0, transparent 3px, #b996ff08 4px),
			linear-gradient(90deg, #ff4fd806 1px, transparent 1px),
			linear-gradient(#40f4ff06 1px, transparent 1px);
		background-size: auto, 42px 42px, 42px 42px;
		color: #f6f1ff;
	}
	.post-shell { width: min(940px, calc(100% - 32px)); margin: 30px auto 70px; }
	.post-back { margin-bottom: 18px; color: #40f4ff; display: inline-flex; align-items: center; gap: 9px; font-family: 'Space Mono', monospace; font-size: 11px; text-decoration: none; }
	.post-window { border: 1px solid #59406f; background: #100e1d; box-shadow: 0 0 0 1px #ff4fd80c, 0 14px 52px #03020b70; }
	.post-header { padding: clamp(24px, 5vw, 52px); border-bottom: 1px solid #453156; }
	.post-kicker { margin: 0 0 20px; color: #a99dbf; font-family: 'Space Mono', monospace; font-size: 10px; }
	.post-kicker span { color: #b9ff66; }
	.post-header h1 { margin: 0 0 15px; font-family: 'Space Grotesk', sans-serif; font-size: clamp(34px, 6vw, 58px); font-weight: 500; line-height: 1.08; }
	.post-description { max-width: 680px; margin: 0 0 18px; color: #c1b6d2; font-size: 15px; line-height: 1.7; }
	.post-meta, .post-tags { color: #8d7eaa; font-family: 'Space Mono', monospace; font-size: 9px; display: flex; flex-wrap: wrap; gap: 8px 14px; }
	.post-tags { margin: 14px 0 0; padding: 0; list-style: none; }
	.post-tags li { padding: 4px 7px; border: 1px solid #392950; color: #a99dbf; }
	.post-content { min-width: 0; padding: clamp(24px, 5vw, 52px); color: #d3c7e2; font-size: 15px; line-height: 1.8; overflow-wrap: anywhere; }
	.post-content h2, .post-content h3, .post-content h4 { margin: 2em 0 0.7em; color: #f6f1ff; font-family: 'Space Grotesk', sans-serif; font-weight: 500; line-height: 1.25; }
	.post-content h2 { font-size: 28px; }
	.post-content h3 { font-size: 21px; }
	.post-content p, .post-content ul, .post-content ol, .post-content blockquote { margin: 0 0 1.25em; }
	.post-content a { color: #40f4ff; text-underline-offset: 3px; }
	.post-content img, .post-content video { display: block; max-width: 100%; height: auto; margin-inline: 0; }
	.post-content iframe { display: block; width: 100%; max-width: 100%; height: auto; border: 0; }
	.post-content pre { box-sizing: border-box; max-width: 100%; padding: 18px; border: 1px solid #453156; background: #0b0b1c; font-size: 12px; line-height: 1.65; overflow-x: auto; overflow-wrap: normal; }
	.post-content code { font-family: 'Space Mono', monospace; font-size: 0.88em; }
	.post-content :not(pre) > code { padding: 2px 5px; border: 1px solid #392950; background: #151321; color: #ff9be9; }
	.post-content blockquote { padding-left: 18px; border-left: 2px solid #ff4fd8; color: #a99dbf; }
	.article-navigation {
		padding: 20px clamp(24px, 5vw, 52px);
		border-top: 1px solid #453156;
		display: flex;
		justify-content: space-between;
		gap: 20px;
	}
	.article-nav-link { min-width: 0; display: flex; flex-direction: column; gap: 7px; text-decoration: none; }
	.article-nav-link.next { margin-left: auto; text-align: right; }
	.article-nav-label { color: #40f4ff; font-family: 'Space Mono', monospace; font-size: 9px; }
	.article-nav-title { color: #e6d9f5; font-family: 'Space Grotesk', sans-serif; font-size: 14px; }
	.article-nav-link:hover .article-nav-title, .article-nav-link:focus-visible .article-nav-title { color: #ff9be9; }
	.article-nav-empty { flex: 1; }
	@media (max-width: 640px) {
		.post-shell { width: calc(100% - 20px); margin: 18px auto 44px; }
		.post-back { font-size: 12px; }
		.post-kicker { font-size: 11px; }
		.post-content { font-size: 15px; }
		.post-content pre { padding: 12px; font-size: 11px; }
		.article-navigation { padding: 17px; gap: 12px; }
		.article-nav-label { font-size: 10px; }
		.article-nav-title { font-size: 13px; }
	}
</style>