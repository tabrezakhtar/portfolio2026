---
import Layout from '../layouts/Layout.astro';
import SideMenu from '../components/SideMenu.astro';

const projects = [
	{
		number: '01',
		title: 'Northstar Finance',
		category: 'Fintech · Product design',
		description: 'A calmer way to see the whole picture and make the next move with confidence.',
		image:
			'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=85',
		alt: 'A colorful analytics dashboard displayed on a laptop',
		className: 'project-image--finance',
	},
	{
		number: '02',
		title: 'Fieldnotes Studio',
		category: 'Creative tools · Web app',
		description: 'A beautifully simple space for creative teams to collect ideas and build on them.',
		image:
			'https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1200&q=85',
		alt: 'Notebook and pen on a designer’s work surface',
		className: 'project-image--fieldnotes',
	},
	{
		number: '03',
		title: 'Goodform Goods',
		category: 'E-commerce · Frontend',
		description: 'A considered storefront that makes discovering everyday objects feel special.',
		image:
			'https://images.unsplash.com/photo-1490312278390-ab64016e0aa9?auto=format&fit=crop&w=1200&q=85',
		alt: 'Sculptural ceramic objects arranged in warm natural light',
		className: 'project-image--goodform',
	},
];

const capabilities = ['Interface design', 'Frontend development', 'Design systems', 'Prototyping'];
---

<Layout>
		<SideMenu />
	<div class="site-shell">
		<header class="site-header">
			<a class="wordmark" href="#home" aria-label="Tabrez, home">tabrez<span>.</span></a>
			<nav class="main-nav" aria-label="Main navigation">
				<a href="#work">Work</a>
				<a href="#about">About</a>
				<a href="#contact">Contact</a>
			</nav>
			<a class="availability" href="mailto:hello@tabrez.dev">
				<span class="availability-dot"></span>
				OPEN TO COLLAB
			</a>
		</header>

		<main>
			<section class="hero" id="home" aria-labelledby="hero-title">
				<div class="terminal-window">
					<div class="terminal-titlebar">
						<div class="terminal-controls" aria-hidden="true"><span></span><span></span><span></span></div>
						<span class="terminal-title">tabrez@localhost <span>~</span> zsh</span>
						<span class="terminal-title-meta">112 × 38</span>
					</div>
					<div class="tmux-tabs" aria-label="Terminal windows">
						<span class="tmux-session">dev-session</span>
						<span class="tmux-tab tmux-tab--active">0: portfolio*</span>
						<a class="tmux-tab" href="#work">1: projects</a>
						<a class="tmux-tab" href="#about">2: about</a>
						<span class="tmux-tabs-spacer"></span>
						<span class="tmux-clock">UTF-8 · 16:42</span>
					</div>
					<div class="terminal-grid">
						<div class="terminal-pane terminal-pane--intro">
							<div class="pane-title"><span>pane 0.0</span><span>~/home</span></div>
							<div class="pane-content">
								<p class="terminal-prompt"><span>tabrez@localhost</span>:~$ whoami</p>
								<p class="eyebrow"><span class="eyebrow-line"></span> Independent developer &amp; designer</p>
								<h1 id="hero-title">Making the internet feel a little more <span>human.</span></h1>
								<p class="hero-description">
									I’m Tabrez, a developer who cares just as much about how it feels as how it works. I turn
									good ideas into useful, thoughtful digital experiences.
								</p>
								<a class="text-link" href="#work">cd ~/projects <span aria-hidden="true">↘</span></a>
							</div>
						</div>
						<div class="terminal-pane terminal-pane--preview">
							<div class="pane-title"><span>pane 0.1</span><span>~/workspace/desk.jpg</span></div>
							<div class="preview-content">
								<img
									class="hero-image"
									src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=85"
									alt="A developer’s laptop open on a bright, leafy desk"
									fetchpriority="high"
								/>
								<div class="image-caption"><span>GOOD IDEAS, BUILT WITH CARE</span><span>↗ 2026</span></div>
							</div>
						</div>
						<div class="terminal-pane terminal-pane--status">
							<div class="pane-title"><span>pane 0.2</span><span>~/status</span></div>
							<div class="status-output">
								<p><span class="prompt-symbol">❯</span> git status --short --branch</p>
								<p><span class="status-branch">##</span> main <span class="status-clean">● working tree clean</span></p>
								<p><span class="prompt-symbol">❯</span> cat stack.txt</p>
								<p class="stack-list">TypeScript <span>·</span> React <span>·</span> Astro <span>·</span> CSS</p>
								<p class="terminal-cursor">▌</p>
							</div>
						</div>
					</div>
					<div class="tmux-statusbar">
						<span class="tmux-status-session">[dev-session]</span>
						<span>0:portfolio*  1:projects-  2:about-</span>
						<span class="tmux-status-right">tabrez · all systems nominal</span>
					</div>
				</div>
			</section>

			<section class="work-section" id="work" aria-labelledby="work-title">
				<div class="terminal-window terminal-project-window">
				<div class="terminal-titlebar">
					<div class="terminal-controls" aria-hidden="true"><span></span><span></span><span></span></div>
					<span class="terminal-title">tabrez@localhost <span>~/projects</span> zsh</span>
					<span class="terminal-title-meta">3 projects</span>
				</div>
				<div class="project-pane-content">
				<div class="section-heading">
					<div>
						<p class="terminal-prompt"><span>tabrez@localhost</span>:~/projects$ ls -lt</p>
						<h2 id="work-title">Recent work<span class="coral-dot">.</span></h2>
					</div>
					<p class="section-aside">Thoughtful details.<br />Useful things. Good people.</p>
				</div>

				<div class="project-list">
					{projects.map((project) => (
						<a class="project-row" href="mailto:hello@tabrez.dev?subject=Tell%20me%20about%20your%20work">
							<div class:list={['project-image-wrap', project.className]}>
								<img src={project.image} alt={project.alt} loading="lazy" />
								<span class="project-number">{project.number}</span>
								<span class="project-visit" aria-hidden="true">↗</span>
							</div>
							<div class="project-info">
								<div>
									<p class="project-category">{project.category}</p>
									<h3>{project.title}</h3>
									<p class="project-description">{project.description}</p>
								</div>
								<span class="project-arrow" aria-hidden="true">↗</span>
							</div>
						</a>
					))}
				</div>
				</div>
				<div class="tmux-statusbar">
					<span class="tmux-status-session">[dev-session]</span>
					<span>0:portfolio-  1:projects*  2:about-</span>
					<span class="tmux-status-right">3 directories · 0 errors</span>
				</div>
				</div>
			</section>

			<section class="about-section" id="about" aria-labelledby="about-title">
				<div class="terminal-window content-window">
					<div class="terminal-titlebar">
						<div class="terminal-controls" aria-hidden="true"><span></span><span></span><span></span></div>
						<span class="terminal-title">tabrez@localhost <span>~/about</span> zsh</span>
						<span class="terminal-title-meta">about.md</span>
					</div>
					<div class="content-pane">
				<div class="about-intro">
					<p class="terminal-prompt"><span>tabrez@localhost</span>:~/about$ cat about.md</p>
					<h2 id="about-title">Curious by nature.<br /><span>Intentional</span> by design.</h2>
				</div>
				<div class="about-details">
					<p class="about-copy">
						The best digital work happens when the details and the bigger picture both matter. I love
						working across the whole process: finding the right problem, shaping the experience, and
						building something that lasts.
					</p>
					<div class="capabilities-block" id="capabilities">
						<p class="capabilities-label">THINGS I CAN HELP WITH</p>
						<ul class="capabilities-list">
							{capabilities.map((capability) => <li>{capability}</li>)}
						</ul>
					</div>
				</div>
					</div>
					<div class="tmux-statusbar">
						<span class="tmux-status-session">[dev-session]</span>
						<span>0:portfolio-  1:projects-  2:about*</span>
						<span class="tmux-status-right">NORMAL · UTF-8</span>
					</div>
				</div>
			</section>

			<section class="contact-section" id="contact" aria-labelledby="contact-title">
				<div class="terminal-window content-window">
					<div class="terminal-titlebar">
						<div class="terminal-controls" aria-hidden="true"><span></span><span></span><span></span></div>
						<span class="terminal-title">tabrez@localhost <span>~/contact</span> zsh</span>
						<span class="terminal-title-meta">hello.txt</span>
					</div>
					<div class="content-pane contact-pane">
						<p class="terminal-prompt"><span>tabrez@localhost</span>:~/contact$ echo $COLLAB</p>
				<p class="eyebrow"><span class="eyebrow-line"></span> Have something good in mind?</p>
				<div class="contact-content">
					<h2 id="contact-title">Let’s make<br />it <span>matter.</span></h2>
					<div class="contact-action">
						<p>Have a project, a question, or just want to say hello? My inbox is open.</p>
						<a class="contact-link" href="mailto:hello@tabrez.dev">
							Say hello <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
					</div>
					<div class="tmux-statusbar">
						<span class="tmux-status-session">[dev-session]</span>
						<span>0:portfolio-  1:projects-  2:about-  3:contact*</span>
						<span class="tmux-status-right">MAIL: OPEN</span>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="wordmark" href="#home">tabrez<span>.</span></a>
			<p>Designed with care. Built with intention.</p>
			<div class="footer-links">
				<a href="https://github.com/" target="_blank" rel="noreferrer">GitHub ↗</a>
				<a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
				<span>© 2026</span>
			</div>
		</footer>
	</div>
</Layout>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		scroll-padding-top: 30px;
	}

	:global(body) {
		margin: 0;
		background-color: #0b0b1c;
		background-image:
			repeating-linear-gradient(0deg, transparent 0, transparent 3px, #b996ff08 4px),
			linear-gradient(90deg, #ff4fd806 1px, transparent 1px),
			linear-gradient(#40f4ff06 1px, transparent 1px);
		background-size: auto, 42px 42px, 42px 42px;
		color: #f6f1ff;
		font-family: 'DM Sans', sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	:global(body::selection) {
		background: #ff4fd8;
		color: #0b0b1c;
	}

	:global(a) {
		color: inherit;
	}

	.site-shell {
		max-width: 1600px;
		margin: 0 auto 0 250px;
		padding: 0 clamp(28px, 5vw, 90px);
	}

	.site-header {
		min-height: 82px;
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		align-items: center;
		border-bottom: 1px solid #312844;
	}

	.wordmark {
		width: fit-content;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 24px;
		font-weight: 700;
		letter-spacing: 0;
		text-decoration: none;
	}

	.wordmark span,
	.coral-dot {
		color: #ff4fd8;
	}

	.main-nav,
	.footer-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 34px;
	}

	.main-nav a,
	.availability,
	.footer-links a {
		font-size: 13px;
		text-decoration: none;
	}

	.main-nav a,
	.footer-links a {
		transition: color 160ms ease;
	}

	.main-nav a:hover,
	.footer-links a:hover {
		color: #40f4ff;
	}

	.availability {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 9px;
	}

	.availability-dot {
		width: 8px;
		aspect-ratio: 1;
		border-radius: 50%;
		background: #b9ff66;
		box-shadow: 0 0 0 4px #b9ff6620, 0 0 12px #b9ff6690;
	}

	.terminal-prompt {
		margin: 0 0 29px;
		color: #a99dbf;
		font-family: 'Space Grotesk', monospace;
		font-size: 11px;
		letter-spacing: 0.2px;
	}

	.terminal-prompt span {
		color: #b9ff66;
	}

	.hero {
		position: relative;
		min-height: 652px;
		padding: 102px 0 58px;
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		align-items: center;
		gap: 42px;
		background: radial-gradient(ellipse at 82% 45%, #6f31a411 0, transparent 48%);
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		padding-bottom: 34px;
		animation: rise-in 650ms both;
	}

	.eyebrow {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 11px;
		color: #a89bbd;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.7px;
		text-transform: uppercase;
	}

	.eyebrow-line,
	.scroll-line {
		width: 27px;
		height: 1px;
		background: #40f4ff;
		box-shadow: 0 0 8px #40f4ff80;
	}

	h1,
	h2,
	h3,
	.project-category,
	.project-description,
	.hero-description,
	.about-copy,
	.contact-action p {
		margin-top: 0;
	}

	h1,
	h2,
	h3 {
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 500;
		letter-spacing: 0;
	}

	.hero h1 {
		max-width: 700px;
		margin: 35px -56px 32px 0;
		font-size: clamp(52px, 6.05vw, 88px);
		line-height: 0.99;
	}

	.hero h1 span,
	.about-intro h2 span {
		color: #ff4fd8;
		text-shadow: 0 0 30px #ff4fd826;
	}

	.hero-bottom {
		max-width: 440px;
	}

	.hero-description,
	.about-copy {
		color: #c1b6d2;
		font-size: 15px;
		line-height: 1.8;
	}

	.hero-description {
		max-width: 395px;
		margin-bottom: 23px;
	}

	.text-link {
		padding-bottom: 5px;
		border-bottom: 1px solid #55436e;
		display: inline-flex;
		align-items: center;
		gap: 19px;
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
	}

	.text-link span {
		color: #40f4ff;
		font-size: 17px;
	}

	.hero-visual {
		position: relative;
		min-width: 0;
		margin-top: 25px;
		animation: rise-in 650ms 120ms both;
	}

	.hero-image {
		width: 100%;
		aspect-ratio: 1.03;
		display: block;
		object-fit: cover;
		border: 1px solid #544273;
		filter: saturate(0.92) contrast(1.04) hue-rotate(8deg);
		box-shadow: 0 0 42px #7531a91c;
	}

	.image-caption {
		margin-top: 12px;
		display: flex;
		justify-content: space-between;
		color: #a89bbd;
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.8px;
	}

	.hero-sticker {
		position: absolute;
		top: 43%;
		left: -45px;
		width: 91px;
		aspect-ratio: 1;
		border: 1px solid #ffb7ed;
		border-radius: 50%;
		background: #ff4fd8;
		color: #160c24;
		box-shadow: 0 0 28px #ff4fd855;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 1.1px;
		line-height: 1.8;
	}

	.hero-sticker span:nth-child(2) {
		font-size: 13px;
	}

	.scroll-note {
		position: absolute;
		bottom: 24px;
		left: 0;
		display: flex;
		align-items: center;
		gap: 11px;
		color: #a89bbd;
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.8px;
		text-decoration: none;
	}

	.work-section {
		padding: 112px 0 117px;
		border-top: 1px solid #312844;
	}

	.section-heading {
		margin-bottom: 55px;
		display: flex;
		align-items: end;
		justify-content: space-between;
	}

	.section-heading h2,
	.about-intro h2 {
		margin: 28px 0 0;
		font-size: clamp(43px, 5.2vw, 68px);
		line-height: 1.04;
	}

	.section-aside {
		margin: 0 0 7px;
		color: #a89bbd;
		font-size: 13px;
		line-height: 1.8;
	}

	.project-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px;
	}

	.project-row {
		min-width: 0;
		text-decoration: none;
	}

	.project-image-wrap {
		position: relative;
		overflow: hidden;
		aspect-ratio: 1.16;
		border: 1px solid #312844;
		background: #171126;
	}

	.project-image-wrap img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		transition: transform 450ms cubic-bezier(0.2, 0.75, 0.3, 1);
	}

	.project-row:hover .project-image-wrap img {
		transform: scale(1.035);
	}

	.project-image--finance img {
		filter: saturate(0.74);
	}

	.project-image--fieldnotes img {
		filter: saturate(0.65) sepia(0.1);
	}

	.project-image--goodform img {
		filter: saturate(0.8);
	}

	.project-number,
	.project-visit {
		position: absolute;
		top: 13px;
		width: 34px;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1px solid #57416e;
		background: #151126;
		color: #f6f1ff;
		display: grid;
		place-items: center;
	}

	.project-number {
		left: 13px;
		font-size: 10px;
		font-weight: 600;
	}

	.project-visit {
		right: 13px;
		font-size: 16px;
		transition: background 160ms ease, color 160ms ease;
	}

	.project-row:hover .project-visit {
		border-color: #40f4ff;
		background: #40f4ff;
		color: #0b0b1c;
	}

	.project-info {
		min-height: 123px;
		padding-top: 17px;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 10px;
	}

	.project-category,
	.capabilities-label {
		margin-bottom: 8px;
		color: #a89bbd;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.45px;
	}

	.project-info h3 {
		margin-bottom: 7px;
		font-size: 23px;
	}

	.project-description {
		max-width: 300px;
		margin-bottom: 0;
		color: #b9aecb;
		font-size: 12px;
		line-height: 1.65;
	}

	.project-arrow {
		margin-top: 27px;
		color: #40f4ff;
		font-size: 18px;
		transition: transform 160ms ease;
	}

	.project-row:hover .project-arrow {
		transform: translate(3px, -3px);
	}

	.about-section {
		padding: 95px 0 100px;
		border-top: 1px solid #312844;
		border-bottom: 1px solid #312844;
		background: linear-gradient(110deg, #ff4fd804, transparent 52%, #40f4ff06);
		display: grid;
		grid-template-columns: 1fr 0.75fr;
		gap: 90px;
	}

	.about-intro h2 {
		font-size: clamp(38px, 4.3vw, 58px);
	}

	.about-details {
		padding-top: 38px;
	}

	.about-copy {
		margin-bottom: 31px;
	}

	.capabilities-label {
		margin-bottom: 13px;
		font-size: 9px;
		letter-spacing: 0.8px;
	}

	.capabilities-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px 18px;
	}

	.capabilities-list li {
		padding-top: 9px;
		border-top: 1px solid #403152;
		font-size: 12px;
	}

	.contact-section {
		padding: 104px 0 108px;
	}

	.contact-content {
		margin-top: 28px;
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 50px;
	}

	.contact-content h2 {
		margin: 0;
		font-size: clamp(66px, 10.1vw, 138px);
		line-height: 0.87;
	}

	.contact-content h2 span {
		color: #ff4fd8;
		text-shadow: 0 0 34px #ff4fd82b;
	}

	.contact-action {
		width: min(295px, 100%);
		padding-bottom: 5px;
	}

	.contact-action p {
		margin-bottom: 19px;
		color: #c1b6d2;
		font-size: 13px;
		line-height: 1.8;
	}

	.contact-link {
		min-width: 142px;
		min-height: 47px;
		padding: 0 17px;
		border: 1px solid #40f4ff;
		background: #151126;
		color: #40f4ff;
		box-shadow: inset 0 0 18px #40f4ff0d, 0 0 18px #40f4ff12;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
