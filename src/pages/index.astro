---
import Layout from '../layouts/Layout.astro';
import SideMenu from '../components/SideMenu.astro';
import Projects from '../components/Projects.astro';
import Services from '../components/Services.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Blog from '../components/Blog.astro';
---

<Layout>
	<SideMenu />
	<div class="site-shell">
		<header class="site-header">
			<a class="wordmark" href="/" aria-label="Tabrez, home">tabrez<span>.</span></a>
			<nav class="main-nav" aria-label="Main navigation">
				<a href="#about">About</a>
				<a href="#projects">Work</a>
				<a href="#services">Services</a>
				<a href="#contact">Contact</a>
			</nav>
			<a class="availability" href="#contact">
				<span class="availability-dot"></span>
				OPEN TO COLLAB
			</a>
		</header>

		<main>
			<Hero />

			<About />
			<Blog />

			<Projects />
			<Services />

			<Contact />
		</main>

		<footer class="site-footer">
			<a class="wordmark" href="/">tabrez<span>.</span></a>
			<p>Still learning.  Still building. The journey continues.</p>
			<div class="footer-links">
				<a href="https://github.com/tabrezakhtar" target="_blank" rel="noreferrer">GitHub ↗</a>
				<a href="https://www.linkedin.com/in/tabrezakhtar" target="_blank" rel="noreferrer">LinkedIn ↗</a>
				<span>© 2026</span>
			</div>
		</footer>
	</div>
</Layout>

<style is:global>
	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 30px;
	}

	body {
		--page-gutter: 10px;
		margin: 0;
		background-color: #0b0b1c;
		background-image:
			repeating-linear-gradient(0deg, transparent 0, transparent 3px, #b996ff08 4px),
			linear-gradient(90deg, #ff4fd806 1px, transparent 1px),
			linear-gradient(#40f4ff06 1px, transparent 1px);
		background-size: auto, 42px 42px, 42px 42px;
		color: #f6f1ff;
		font-family: 'DM Sans', sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	body::selection {
		background: #ff4fd8;
		color: #0b0b1c;
	}

	a {
		color: inherit;
	}

	.site-shell {
		width: auto;
		max-width: none;
		margin: var(--page-gutter) var(--page-gutter) var(--page-gutter) calc(250px + 2 * var(--page-gutter));
		padding: 0;
	}

	.site-header {
		min-height: 82px;
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		align-items: center;
		border-bottom: 1px solid #312844;
	}

	.wordmark {
		width: fit-content;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 24px;
		font-weight: 700;
		letter-spacing: 0;
		text-decoration: none;
	}

	.wordmark span,
	.coral-dot {
		color: #ff4fd8;
	}

	.main-nav,
	.footer-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 34px;
	}

	.main-nav a,
	.availability,
	.footer-links a {
		font-size: 13px;
		text-decoration: none;
	}

	.main-nav a,
	.footer-links a {
		transition: color 160ms ease;
	}

	.main-nav a:hover,
	.footer-links a:hover {
		color: #40f4ff;
	}

	.availability {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 9px;
	}

	.availability-dot {
		width: 8px;
		aspect-ratio: 1;
		border-radius: 50%;
		background: #b9ff66;
		box-shadow: 0 0 0 4px #b9ff6620, 0 0 12px #b9ff6690;
	}

	.terminal-prompt {
		margin: 0 0 29px;
		color: #a99dbf;
		font-family: 'Space Grotesk', monospace;
		font-size: 11px;
		letter-spacing: 0.2px;
	}

	.terminal-prompt span {
		color: #b9ff66;
	}

	.hero {
		position: relative;
		min-height: 652px;
		padding: 102px 0 58px;
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		align-items: center;
		gap: 42px;
		background: radial-gradient(ellipse at 82% 45%, #6f31a411 0, transparent 48%);
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		padding-bottom: 34px;
		animation: rise-in 650ms both;
	}

	.eyebrow {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 11px;
		color: #a89bbd;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.7px;
		text-transform: uppercase;
	}

	.eyebrow-line,
	.scroll-line {
		width: 27px;
		height: 1px;
		background: #40f4ff;
		box-shadow: 0 0 8px #40f4ff80;
	}

	h1,
	h2,
	h3,
	.project-category,
	.project-description,
	.hero-description,
	.about-copy,
	.contact-action p {
		margin-top: 0;
	}

	h1,
	h2,
	h3 {
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 500;
		letter-spacing: 0;
	}

	.hero h1 {
		max-width: 700px;
		margin: 35px -56px 32px 0;
		font-size: clamp(52px, 6.05vw, 88px);
		line-height: 0.99;
	}

	.hero h1 span,
	.about-intro h2 span {
		color: #ff4fd8;
		text-shadow: 0 0 30px #ff4fd826;
	}

	.hero-bottom {
		max-width: 440px;
	}

	.hero-description,
	.about-copy {
		color: #c1b6d2;
		font-size: 15px;
		line-height: 1.8;
	}

	.hero-description {
		max-width: 395px;
		margin-bottom: 23px;
	}

	.text-link {
		padding-bottom: 5px;
		border-bottom: 1px solid #55436e;
		display: inline-flex;
		align-items: center;
		gap: 19px;
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
	}

	.text-link span {
		color: #40f4ff;
		font-size: 17px;
	}

	.scroll-note {
		position: absolute;
		bottom: 24px;
		left: 0;
		display: flex;
		align-items: center;
		gap: 11px;
		color: #a89bbd;
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.8px;
		text-decoration: none;
	}

	.work-section {
		padding: 112px 0 117px;
		border-top: 1px solid #312844;
	}

	.section-heading {
		margin-bottom: 55px;
		display: flex;
		align-items: end;
		justify-content: space-between;
	}

	.section-heading h2,
	.about-intro h2 {
		margin: 28px 0 0;
		font-size: clamp(43px, 5.2vw, 68px);
		line-height: 1.04;
	}

	.section-aside {
		margin: 0 0 7px;
		color: #a89bbd;
		font-size: 13px;
		line-height: 1.8;
	}

	.contact-section {
		padding: 104px 0 108px;
	}

	.contact-content {
		margin-top: 28px;
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 50px;
	}

	.contact-content h2 {
		margin: 0;
		font-size: clamp(66px, 10.1vw, 138px);
		line-height: 0.87;
	}

	.contact-content h2 span {
		color: #ff4fd8;
		text-shadow: 0 0 34px #ff4fd82b;
	}

	.contact-action {
		width: min(295px, 100%);
		padding-bottom: 5px;
	}

	.contact-action p {
		margin-bottom: 19px;
		color: #c1b6d2;
		font-size: 13px;
		line-height: 1.8;
	}

	.contact-link {
		min-width: 142px;
		min-height: 47px;
		padding: 0 17px;
		border: 1px solid #40f4ff;
		background: #151126;
		color: #40f4ff;
		box-shadow: inset 0 0 18px #40f4ff0d, 0 0 18px #40f4ff12;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		font-size: 12px;
		text-decoration: none;
		transition: background 160ms ease;
	}

	.contact-link:hover {
		background: #40f4ff;
		color: #0b0b1c;
		box-shadow: 0 0 24px #40f4ff55;
	}

	.contact-heading {
		margin: 20px 0 30px;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(230px, 0.55fr);
		align-items: end;
		gap: 32px;
	}

	.contact-heading h2 {
		margin: 0;
		font-size: 76px;
		line-height: 0.94;
	}

	.contact-heading h2 span {
		color: #ff4fd8;
		text-shadow: 0 0 34px #ff4fd82b;
	}

	.contact-heading p {
		margin: 0 0 4px;
		color: #c1b6d2;
		font-size: 13px;
		line-height: 1.8;
	}

	.contact-heading a {
		color: #40f4ff;
		text-underline-offset: 3px;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: minmax(200px, 0.72fr) minmax(0, 1.28fr);
		align-items: start;
		gap: 24px;
	}

	.contact-location,
	.contact-form {
		min-width: 0;
		padding: 18px;
		border: 1px solid #392950;
		background: #12111b;
	}

	.location-copy {
		margin-bottom: 16px;
		display: flex;
		align-items: flex-start;
		gap: 12px;
	}

	.location-copy > i {
		color: #40f4ff;
		font-size: 20px;
	}

	.location-copy h3 {
		margin: 1px 0 5px;
		font-family: 'Space Mono', monospace;
		font-size: 12px;
	}

	.location-copy p {
		margin: 0;
		color: #a89bbd;
		font-size: 11px;
		line-height: 1.6;
	}

	.contact-map {
		width: 100%;
		height: 245px;
		border: 1px solid #453156;
		background: #171326;
		filter: grayscale(0.75) saturate(0.65);
	}

	.contact-form {
		display: grid;
		gap: 16px;
	}

	.form-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
	}

	.form-field {
		min-width: 0;
		display: grid;
		gap: 7px;
	}

	.form-field label {
		color: #c1b6d2;
		font-family: 'Space Mono', monospace;
		font-size: 10px;
	}

	.form-field input,
	.form-field textarea {
		width: 100%;
		min-height: 42px;
		padding: 10px 11px;
		border: 1px solid #453156;
		border-radius: 0;
		background: #0d0c15;
		color: #f6f1ff;
		font: inherit;
		font-size: 12px;
	}

	.form-field textarea {
		min-height: 138px;
		resize: vertical;
	}

	.form-field input:focus-visible,
	.form-field textarea:focus-visible {
		outline: 2px solid #40f4ff;
		outline-offset: 2px;
	}

	.contact-submit {
		min-height: 44px;
		padding: 0 14px;
		border: 1px solid #40f4ff;
		border-radius: 0;
		background: #40f4ff;
		color: #0b0b1c;
		justify-self: start;
		font-family: 'Space Mono', monospace;
		font-size: 11px;
		font-weight: 700;
		cursor: pointer;
		transition: background 160ms ease, color 160ms ease;
	}

	.contact-submit span {
		margin-left: 18px;
	}

	.contact-submit:hover {
		background: transparent;
		color: #40f4ff;
	}

	.form-honeypot {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.site-footer {
		min-height: 82px;
		border-top: 1px solid #312844;
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		align-items: center;
		gap: 15px;
	}

	.site-footer .wordmark {
		font-size: 20px;
	}

	.site-footer > p,
	.footer-links span {
		margin: 0;
		color: #a89bbd;
		font-size: 10px;
		text-align: center;
	}

	.footer-links {
		justify-content: flex-end;
		gap: 17px;
	}

	.footer-links a,
	.footer-links span {
		font-size: 10px;
	}

	.site-header {
		min-height: 58px;
		padding: 0 15px;
		border: 1px solid #392950;
		border-top: 2px solid #ff4fd8;
		background: #110f20;
	}

	.site-header .wordmark,
	.site-footer .wordmark {
		font-family: 'Space Mono', monospace;
	}

	.site-header .wordmark::before {
		content: '~/';
		margin-right: 5px;
		color: #40f4ff;
	}

	.main-nav a {
		color: #c1b6d2;
		font-family: 'Space Mono', monospace;
		font-size: 11px;
	}

	.availability {
		color: #b9ff66;
		font-family: 'Space Mono', monospace;
		font-size: 10px;
	}

	.hero {
		min-height: 0;
		padding: 20px 0 20px;
		display: block;
		background: none;
	}

	.terminal-window {
		position: relative;
		min-width: 0;
		border: 1px solid #59406f;
		background: #100e1d;
		box-shadow: 0 0 0 1px #ff4fd80c, 0 14px 52px #03020b70, 0 0 32px #8c38ff12;
	}

	.terminal-titlebar {
		min-height: 37px;
		padding: 0 13px;
		border-bottom: 1px solid #38294b;
		background: #121511;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
	}

	.terminal-title-mark {
		margin-right: 9px;
		color: #b9ff66;
		font-family: 'Space Mono', monospace;
		font-size: 11px;
		font-weight: 700;
	}

	.terminal-title,
	.terminal-title-meta,
	.tmux-tabs,
	.tmux-statusbar,
	.pane-title,
		.terminal-prompt {
		font-family: 'Space Mono', monospace;
	}

	.terminal-title {
		justify-self: start;
		color: #e6d9f5;
		font-size: 10px;
	}

	.terminal-title > span {
		color: #b99aff;
	}

	.terminal-title-meta {
		justify-self: end;
		color: #8d7eaa;
		font-size: 9px;
	}

	.tmux-tabs {
		min-height: 32px;
		padding: 0 12px;
		border-bottom: 1px solid #453156;
		background: #1a1529;
		display: flex;
		align-items: center;
		gap: 15px;
		color: #a99dbf;
		font-size: 9px;
	}

	.tmux-session,
	.tmux-tab--active {
		color: #b9ff66;
	}

	.tmux-tab {
		text-decoration: none;
		transition: color 160ms ease;
	}

	.tmux-tab:hover {
		color: #40f4ff;
	}

	.tmux-tabs-spacer {
		flex: 1;
	}

	.tmux-clock {
		color: #40f4ff;
	}

	.terminal-grid {
		min-width: 0;
		padding: 12px;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: minmax(360px, auto) auto;
		gap: 2px;
		background: #392950;
	}

	.terminal-pane {
		min-width: 0;
		overflow: hidden;
		border: 1px solid #413052;
		background: #100e1d;
	}

	.pane-title {
		min-height: 27px;
		padding: 0 10px;
		border-bottom: 1px solid #38294b;
		background: #171326;
		color: #847499;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 9px;
	}

	.pane-title span:first-child {
		color: #40f4ff;
	}

	.pane-content {
		padding: 25px clamp(18px, 3.2vw, 42px) 25px;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: stretch;
		gap: clamp(20px, 4vw, 48px);
	}

	.hero-copy {
		min-width: 0;
	}

	.terminal-prompt {
		margin: 0 0 23px;
		color: #d3c7e2;
		font-size: 10px;
	}

	.terminal-prompt span {
		color: #b9ff66;
	}

	.terminal-pane .eyebrow {
		font-size: 9px;
	}

	.terminal-pane .eyebrow-line {
		background: #ff4fd8;
		box-shadow: 0 0 8px #ff4fd880;
	}

	.terminal-pane .hero h1,
	.hero h1 {
		max-width: 690px;
		margin: 28px 0 23px;
		font-size: clamp(43px, 5.1vw, 70px);
		line-height: 1.04;
	}

	.terminal-pane .hero-description {
		max-width: 500px;
		font-size: 13px;
	}

	.terminal-pane .text-link {
		border-color: #59406f;
		font-family: 'Space Mono', monospace;
		font-size: 10px;
	}

	.tmux-statusbar {
		min-height: 26px;
		padding: 0 11px;
		background: #403056;
		color: #e9dff4;
		display: flex;
		align-items: center;
		gap: 16px;
		font-size: 9px;
	}

	.tmux-status-session {
		padding: 3px 6px;
		background: #ff4fd8;
		color: #180e23;
		font-weight: 700;
	}

	.tmux-status-right {
		margin-left: auto;
		color: #40f4ff;
	}

	.about-section,
	.contact-section {
		padding: 0 0 20px;
		border: 0;
		background: none;
		display: block;
	}

	.content-pane {
		padding: 32px clamp(20px, 4vw, 48px) 36px;
	}

	.about-intro .terminal-prompt,
	.contact-pane .terminal-prompt {
		margin-bottom: 20px;
	}

	.content-pane .eyebrow {
		color: #40f4ff;
		font-family: 'Space Mono', monospace;
		font-size: 9px;
	}

	.about-section .content-pane {
		display: block;
	}

	.about-content > .terminal-prompt {
		margin-bottom: 15px;
	}

	.about-content h2 {
		margin: 0 0 20px;
		font-size: clamp(36px, 4.2vw, 52px);
	}

	.about-bio {
		max-width: 780px;
		color: #c1b6d2;
		font-size: 13px;
		line-height: 1.8;
	}

	.about-bio p {
		margin: 0 0 13px;
	}

	.about-invitation {
		color: #f6f1ff;
	}

	.about-invitation a,
	.about-projects a {
		color: #40f4ff;
		text-decoration-color: #40f4ff70;
		text-underline-offset: 3px;
	}

	.company-strip,
	.about-projects {
		margin-top: 30px;
	}

	.company-strip .capabilities-label,
	.about-projects .capabilities-label {
		margin-bottom: 12px;
		color: #a89bbd;
	}

	.company-logos {
		display: flex;
		gap: 10px;
		overflow-x: auto;
		padding-bottom: 6px;
		scroll-snap-type: x proximity;
	}

	.company-logo-item {
		min-width: 112px;
		height: 58px;
		padding: 9px 13px;
		border: 1px solid #392950;
		background: #151321;
		display: grid;
		place-items: center;
		scroll-snap-align: start;
	}

	.company-logo-item img {
		max-width: 100%;
		max-height: 38px;
		display: block;
		object-fit: contain;
	}

	.about-projects ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 24px;
	}

	.about-projects li {
		padding: 11px 0;
		border-top: 1px solid #453156;
		color: #c1b6d2;
		font-size: 11px;
		line-height: 1.65;
	}

	.about-intro h2 {
		font-size: clamp(38px, 4.3vw, 58px);
	}

	.about-copy {
		margin-top: 35px;
		font-size: 13px;
	}

	.capabilities-label {
		font-family: 'Space Mono', monospace;
		font-size: 9px;
	}

	.capabilities-list li {
		border-color: #453156;
		font-size: 11px;
	}

	.contact-pane .eyebrow-line {
		background: #ff4fd8;
		box-shadow: 0 0 8px #ff4fd880;
	}

	.contact-content h2 {
		font-size: clamp(60px, 9vw, 110px);
	}

	.contact-action p {
		font-size: 12px;
	}

	.contact-link {
		font-family: 'Space Mono', monospace;
	}

	.site-footer {
		padding: 0 12px;
		border: 1px solid #392950;
		border-bottom: 2px solid #40f4ff;
		background: #110f20;
	}

	.site-footer .wordmark::before {
		content: '~/';
		margin-right: 5px;
		color: #40f4ff;
	}

	.site-footer > p,
	.footer-links a,
	.footer-links span {
		font-family: 'Space Mono', monospace;
	}

	@keyframes rise-in {
		from {
